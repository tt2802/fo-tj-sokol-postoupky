---
layout: layouts/page.njk
title: TJ Sokol Postoupky
permalink: /
hideTitle: true
---

<section class="hero">
  <div class="container">
    <div class="hero__inner">
      <div class="hero__text">
        <h1>TJ Sokol Postoupky</h1>
        <p class="muted">
          Fotbalový oddíl pro muže a mládež. Tréninky několikrát v týdnu v Sokolovně Postoupky.
        </p>

        <div class="hero__cta">
          <a class="btn" href="{{ '/novinky/' | url }}">Novinky</a>
          <a class="btn btn--ghost" href="{{ '/nabor/' | url }}">Nábor</a>
        </div>
      </div>

      <div class="hero__badge" aria-hidden="true">
        <div class="hero__badgeInner">⚽</div>
      </div>
    </div>
  </div>
</section>

<section class="section calendar-section">
  <div class="container">

    {% if calendarComputed.months.length %}

      {% set firstMonth = calendarComputed.months[0] %}
      <div class="cal-layout">

        <div class="cal-widget">
          {# Header with month nav #}
          <div class="cal-header">
            <button class="cal-nav" data-cal-dir="prev" aria-label="Předchozí měsíc">&#9664;</button>
            <span class="cal-header__title" id="calTitle">{{ firstMonth.label }}</span>
            <button class="cal-nav" data-cal-dir="next" aria-label="Další měsíc">&#9654;</button>
          </div>

          {# Month grids #}
          {% for m in calendarComputed.months %}
          <table class="cal-table{% if m.active %} is-active{% endif %}"
                 data-cal-grid="{{ m.key }}" data-cal-label="{{ m.label }}">
            <thead>
              <tr>
                {% for dh in calendarComputed.dayHeaders %}
                  <th>{{ dh }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in m.rows %}
              <tr>
                {% for cell in row %}
                  {% if cell.empty %}
                    <td class="cal-empty"></td>
                  {% else %}
                    <td class="cal-day{% if cell.isToday %} cal-today{% endif %}{% if cell.isPast %} cal-past{% endif %}{% if cell.isWeekend %} cal-weekend{% endif %}{% if cell.events.length %} cal-has-ev{% endif %}"{% if cell.events.length %} title="{% for ev in cell.events %}{{ ev.icon }} {{ ev.title }}{% if ev.time %} · {{ ev.time }}{% endif %}{% if not loop.last %}&#10;{% endif %}{% endfor %}"{% endif %}>
                      <span class="cal-num">{{ cell.day }}</span>
                      {% if cell.events.length %}
                        <span class="cal-dots">{% for ev in cell.events %}<i class="cal-dot cal-dot--{{ ev.type }}"></i>{% endfor %}</span>
                      {% endif %}
                    </td>
                  {% endif %}
                {% endfor %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endfor %}

          {# Legend #}
          <div class="cal-legend">
            <span><i class="cal-dot cal-dot--match"></i> Zápas</span>
            <span><i class="cal-dot cal-dot--training"></i> Trénink</span>
            <span><i class="cal-dot cal-dot--tournament"></i> Turnaj</span>
            <span><i class="cal-dot cal-dot--camp"></i> Soustředění</span>
            <span><i class="cal-dot cal-dot--meeting"></i> Schůze</span>
          </div>
        </div>

        {# Upcoming events – side panel #}
        <div class="cal-sidebar">
          <div class="cal-sidebar__head">Nadcházející akce</div>
          {% for event in calendarComputed.allEvents %}
          {% if loop.index0 < 8 %}
            <div class="cal-up cal-up--{{ event.type }}">
              <div class="cal-up__date">
                <span class="cal-up__day">{{ event.date | czDateDay }}</span>
                <span class="cal-up__mon">{{ event.date | czDateMonth }}</span>
              </div>
              <div class="cal-up__info">
                <span class="cal-up__title">{{ event.title }}</span>
                <span class="cal-up__meta">{% if event.time %}{{ event.time }}{% if event.endTime %}–{{ event.endTime }}{% endif %}{% endif %}{% if event.location %}{% if event.time %} · {% endif %}{{ event.location }}{% endif %}</span>
              </div>
              <i class="cal-dot cal-dot--{{ event.type }}"></i>
            </div>
          {% endif %}
          {% endfor %}
        </div>

      </div>

      <script>
      (function(){
        var tables=document.querySelectorAll('.cal-table');
        var navs=document.querySelectorAll('.cal-nav');
        var title=document.getElementById('calTitle');
        var cur=0;
        function show(i){
          if(i<0||i>=tables.length) return;
          tables[cur].classList.remove('is-active');
          cur=i;
          tables[cur].classList.add('is-active');
          title.textContent=tables[cur].getAttribute('data-cal-label');
        }
        navs.forEach(function(b){
          b.addEventListener('click',function(){
            show(cur+(b.getAttribute('data-cal-dir')==='prev'?-1:1));
          });
        });
      })();
      </script>

    {% else %}
      <p class="muted" style="text-align: center;">Zatím nejsou naplánovány žádné akce.</p>
    {% endif %}
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 style="text-align: center; margin-bottom: 2rem;">Fotbalové týmy</h2>
    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
      <a href="{{ '/muzi/' | url }}" class="card" style="text-decoration: none; color: inherit; cursor: pointer;">
        <div class="card__body" style="text-align: center; padding: 2rem;">
          <h3 class="card__title">🏆 Muži</h3>
          <p class="muted">Přehled zápasů a týmu</p>
        </div>
      </a>

      <a href="{{ '/mladez/' | url }}" class="card" style="text-decoration: none; color: inherit; cursor: pointer;">
        <div class="card__body" style="text-align: center; padding: 2rem;">
          <h3 class="card__title">👶 Mládež</h3>
          <p class="muted">Všechny věkové kategorie</p>
        </div>
      </a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="homeCards">
      <article class="card">
        <div class="card__body">
          <h2 class="card__title">Nejbližší zápas</h2>

          {% if matchesComputed.nextMatch %}
            <p class="muted">
              {{ matchesComputed.nextMatch._dateStr | czDate }}
              {% if matchesComputed.nextMatch.time %} · {{ matchesComputed.nextMatch.time }}{% endif %}
            </p>

            <p class="homeMatchLine">
              <strong>{{ matchesComputed.nextMatch.home }}</strong>
              vs
              <strong>{{ matchesComputed.nextMatch.away }}</strong>
            </p>

            {% if matchesComputed.nextMatch.venue %}
              <p class="muted">Místo: {{ matchesComputed.nextMatch.venue }}</p>
            {% endif %}

            <p>
              {% if matchesComputed.nextMatch.team == "muzi" %}
                <a href="{{ '/muzi/zapasy/' | url }}">Zobrazit všechny zápasy Mužů</a>
              {% else %}
                <a href="{{ '/mladez/' | url }}">Zobrazit všechny zápasy Mládeže</a>
              {% endif %}
            </p>
          {% else %}
            <p class="muted">Zatím nemáme vypsaný žádný další zápas.</p>
            <p><a href="{{ '/muzi/zapasy/' | url }}">Přejít na zápasy</a></p>
          {% endif %}
        </div>
      </article>

      <article class="card">
        <div class="card__body">
          <h2 class="card__title">Poslední výsledek</h2>

          {% if matchesComputed.lastResult %}
            <p class="muted">
              {{ matchesComputed.lastResult._dateStr | czDate }}
              {% if matchesComputed.lastResult.competition %} · {{ matchesComputed.lastResult.competition }}{% endif %}
            </p>

            <p class="homeMatchLine">
              <strong>{{ matchesComputed.lastResult.home }}</strong>
              {{ matchesComputed.lastResult.homeScore }} : {{ matchesComputed.lastResult.awayScore }}
              <strong>{{ matchesComputed.lastResult.away }}</strong>
            </p>

            {% if matchesComputed.lastResult.venue %}
              <p class="muted">Místo: {{ matchesComputed.lastResult.venue }}</p>
            {% endif %}

            <p>
              {% if matchesComputed.lastResult.team == "muzi" %}
                <a href="{{ '/muzi/zapasy/' | url }}">Historie zápasů Mužů</a>
              {% else %}
                <a href="{{ '/mladez/' | url }}">Historie zápasů Mládeže</a>
              {% endif %}
            </p>
          {% else %}
            <p class="muted">Zatím nemáme zapsaný žádný výsledek.</p>
            <p><a href="{{ '/muzi/zapasy/' | url }}">Doplnit výsledky</a></p>
          {% endif %}
        </div>
      </article>

      <article class="card">
        <div class="card__body">
          <h2 class="card__title">Poslední novinky</h2>

          {% set latest = collections.news | slice(0, 3) %}

          {% if latest.length %}
            <ol class="homeNewsList">
              {% for post in latest %}
                <li>
                  <a href="{{ post.url }}">{{ post.data.title }}</a>
                  <span class="muted"> · {{ post.date | czDate }}</span>
                </li>
              {% endfor %}
            </ol>

            <p><a href="{{ '/novinky/' | url }}">Všechny novinky</a></p>
          {% else %}
            <p class="muted">Zatím tu nejsou žádné novinky.</p>
            <p><a href="{{ '/admin/' | url }}">Přidat novinku</a></p>
          {% endif %}
        </div>
      </article>
    </div>
  </div>
</section>

