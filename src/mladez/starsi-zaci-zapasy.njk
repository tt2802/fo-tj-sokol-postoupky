---
title: Zápasy Starších žáků
permalink: /mladez/starsi-zaci/zapasy/index.html
layout: layouts/page.njk
---


<section class="section">
  <div class="container">
    <h1>Zápasy Starších žáků (U15)</h1>
    <p class="muted">Přehled všech zápasů kategorie starších žáků.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% set youthMatches = matchesComputed.upcoming | where('team', 'mladez') | where('category', 'starsi-zaci') %}
    {% set youthPlayed = matchesComputed.played | where('team', 'mladez') | where('category', 'starsi-zaci') %}

    {% if youthMatches | length > 0 %}
      <h2>Nadcházející zápasy</h2>
      <div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
        {% for m in youthMatches %}
          <article class="card match-card" data-season="{{ m.season }}" data-competition="{{ m.competition }}" data-team="mladez" style="border-left: 4px solid #4CAF50;">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}{% if m.time %} · {{ m.time }}{% endif %}</p>
              <h3><strong>{{ m.home }}</strong> vs <strong>{{ m.away }}</strong></h3>
              <p class="muted">{{ m.venue }} · {{ m.competition }}</p>
              {% if m.liveUrl %}
                <p><a class="btn btn--secondary" href="{{ m.liveUrl }}" target="_blank" rel="noopener">Otevřít na YouTube</a></p>
              {% endif %}
              <p style="margin-top: 0.5rem;"><a href="{{ ('/mladez/starsi-zaci/zapasy/' ~ m.slug ~ '/') | url }}">Detail zápasu</a></p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if youthPlayed | length > 0 %}
      <h2>Odehrané zápasy</h2>
      <div style="display: grid; gap: 1rem;">
        {% for m in youthPlayed %}
          <article class="card match-card" data-season="{{ m.season }}" data-competition="{{ m.competition }}" data-team="mladez">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}</p>
              <h3>
                <strong>{{ m.home }}</strong>
                {% if m.homeScore is number and m.awayScore is number %}
                  <span style="color: var(--text-muted);">{{ m.homeScore }} : {{ m.awayScore }}</span>
                {% endif %}
                <strong>{{ m.away }}</strong>
              </h3>
              <p class="muted">{{ m.competition }}</p>
              {% if m.videoUrl %}
                <p><a class="btn btn--secondary" href="{{ m.videoUrl }}" target="_blank" rel="noopener">Přehrát video zápasu</a></p>
              {% endif %}
              <p style="margin-top: 0.5rem;"><a href="{{ ('/mladez/starsi-zaci/zapasy/' ~ m.slug ~ '/') | url }}">Detail zápasu</a></p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if youthMatches | length == 0 and youthPlayed | length == 0 %}
      <p class="muted">Zatím zde nejsou žádné zápasy.</p>
    {% endif %}
  </div>
</section>

<script defer src="{{ '/assets/js/matches-filter.js' | url }}"></script>
