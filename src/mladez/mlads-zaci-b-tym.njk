title: Tým Mladších žáků B
permalink: /mladez/mlads-zaci-b/tym/index.html
layout: layouts/page.njk
---

<nav class="muted" aria-label="Drobečková navigace" style="margin-bottom: 2rem;">
  <a href="{{ '/mladez/mlads-zaci-b/' | url }}">← Zpět na Mladší žáci B</a>
</nav>

<section class="section">
  <div class="container">
    <h1>Tým Mladších žáků B (U12)</h1>
    <p class="muted">Soupiska hráčů kategorie Mladší žáci B.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Hráči</h2>

    {% set playersB = players.youth["mlads-zaci-b"] | default([]) %}

    {% if playersB | length == 0 %}
      <p class="muted">Zatím zde nejsou žádní hráči. Doplníš je v administraci v sekci „Data → Hráči – Mládež - Mladší žáci B".</p>
    {% else %}
      <div class="grid cards" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem;">
        {% for p in playersB %}
          <article class="card">
            <div class="card__media">
              {% if p.photo %}
                <img src="{{ p.photo }}" alt="Fotka hráče {{ p.name }}" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px 4px 0 0;">
              {% else %}
                <div style="width: 100%; aspect-ratio: 1; background: var(--bg-alt); border-radius: 4px 4px 0 0; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                  Bez fotky
                </div>
              {% endif %}
            </div>

            <div class="card__body">
              <h3 class="card__title">
                {% if p.number %}<span style="font-size: 0.8em; color: var(--text-muted);">#{{ p.number }}</span> {% endif %}{{ p.name }}
              </h3>
              {% if p.position %}
                <p class="muted">{{ p.position }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
