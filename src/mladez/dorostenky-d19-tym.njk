title: Tým Dorostenek D19
permalink: /mladez/dorostenky-d19/tym/index.html
layout: layouts/page.njk
---


<section class="section">
  <div class="container">
    <h1>Tým Dorostenek (D19)</h1>
    <p class="muted">Soupiska hráček kategorie Dorostenkyně D19.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Hráčky</h2>

    {% set playersD19 = players.youth["dorostenky-d19"] | default([]) %}

    {% if playersD19 | length == 0 %}
      <p class="muted">Zatím zde nejsou žádné hráčky. Doplníš je v administraci v sekci „Data → Hráči – Mládež - Dorostenkyně D19".</p>
    {% else %}
      <div class="grid cards" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem;">
        {% for p in playersD19 %}
          <article class="card">
            <div class="card__media" style="--media-aspect: 1 / 1; --media-radius: 4px 4px 0 0;">
              {% if p.photo %}
                {% image p.photo, "Fotka hráčky " ~ p.name, "(max-width: 280px) 100vw, 280px", "player-photo" %}
              {% else %}
                <div class="media-frame__placeholder media-frame__placeholder--compact">Bez fotky</div>
              {% endif %}
            </div>

            <div class="card__body">
              <h3 class="card__title">
                {% if p.number %}<span style="font-size: 0.8em; color: var(--text-muted);">#{{ p.number }}</span> {% endif %}{{ p.name }}
              </h3>
              {% if p.position %}
                <p class="muted">{{ p.position }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
