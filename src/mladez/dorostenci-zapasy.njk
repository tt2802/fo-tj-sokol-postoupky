---
title: Zápasy Dorosteňců
permalink: /mladez/dorostenci/zapasy/index.html
layout: layouts/page.njk
---

<nav class="muted" aria-label="Drobečková navigace" style="margin-bottom: 2rem;">
  <a href="{{ '/mladez/dorostenci/' | url }}">← Zpět na Dorostence</a>
</nav>

<section class="section">
  <div class="container">
    <h1>Zápasy Dorosteňců (U19)</h1>
    <p class="muted">Přehled všech zápasů kategorie dorosteňců.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% set youthMatches = matchesComputed.upcoming | where('team', 'mladez') | where('category', 'dorostenci') %}
    {% set youthPlayed = matchesComputed.played | where('team', 'mladez') | where('category', 'dorostenci') %}

    {% if youthMatches | length > 0 %}
      <h2>Nadcházející zápasy</h2>
      <div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
        {% for m in youthMatches %}
          <a href="{{ ('/mladez/dorostenci/zapasy/' ~ m.slug ~ '/') | url }}" class="card" style="border-left: 4px solid #4CAF50; text-decoration: none; color: var(--text); cursor: pointer;">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}{% if m.time %} · {{ m.time }}{% endif %}</p>
              <h3><strong>{{ m.home }}</strong> vs <strong>{{ m.away }}</strong></h3>
              <p class="muted">{{ m.venue }} · {{ m.competition }}</p>
              {% if m.videoUrl %}<p style="margin-top: 0.5rem; font-size: 0.9rem;">🎥 Video dostupné</p>{% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if youthPlayed | length > 0 %}
      <h2>Odehrané zápasy</h2>
      <div style="display: grid; gap: 1rem;">
        {% for m in youthPlayed %}
          <a href="{{ ('/mladez/dorostenci/zapasy/' ~ m.slug ~ '/') | url }}" class="card" style="text-decoration: none; color: inherit; cursor: pointer;">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}</p>
              <h3>
                <strong>{{ m.home }}</strong>
                {% if m.homeScore is number and m.awayScore is number %}
                  <span style="color: var(--text-muted);">{{ m.homeScore }} : {{ m.awayScore }}</span>
                {% endif %}
                <strong>{{ m.away }}</strong>
              </h3>
              <p class="muted">{{ m.competition }}</p>
              {% if m.videoUrl %}<p style="margin-top: 0.5rem; font-size: 0.9rem;">🎥 Video dostupné</p>{% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if youthMatches | length == 0 and youthPlayed | length == 0 %}
      <p class="muted">Zatím zde nejsou žádné zápasy.</p>
    {% endif %}
  </div>
</section>
