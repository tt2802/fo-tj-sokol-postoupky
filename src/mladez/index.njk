---
title: Mládež
permalink: /mladez/index.html
layout: layouts/page.njk
---

<section class="section">
  <div class="container">
    <h1>Fotbalové týmy Mládeže</h1>
    <p class="muted">Hier všechny věkové kategorie – od miniféry až po dorostence.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% for cat in categories.items %}
      <section style="margin-bottom: 2.5rem;">
        <h2>{{ cat.name }} <span style="font-size:0.9em; color:#666;">({{ cat.shortName }})</span></h2>

        {% set catPlayers = players.youth[cat.id] | default([]) %}

        {% if catPlayers | length == 0 %}
          <p class="muted">Zatím zde nejsou žádní hráči pro kategorii {{ cat.name }}. Doplníš je v administraci v sekci „Data → Hráči – Mládež".</p>
        {% else %}
          <div class="grid cards" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.25rem;">
            {% for p in catPlayers %}
              <article class="card">
                <div class="card__media">
                  {% if p.photo %}
                    <img src="{{ p.photo }}" alt="Fotka hráče {{ p.name }}" style="width:100%; aspect-ratio:1; object-fit:cover; border-radius:4px 4px 0 0;">
                  {% else %}
                    <div style="width:100%; aspect-ratio:1; background:#eaeaea; display:flex; align-items:center; justify-content:center; color:#999;">Bez fotky</div>
                  {% endif %}
                </div>
                <div class="card__body">
                  <h3 class="card__title">{% if p.number %}<span style="font-size:0.85em; color:#999;">#{{ p.number }}</span> {% endif %}{{ p.name }}</h3>
                  {% if p.position %}<p class="muted">{{ p.position }}</p>{% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        {% endif %}
      </section>
    {% endfor %}
  </div>
</section>
