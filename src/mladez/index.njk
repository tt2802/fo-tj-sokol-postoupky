---
title: Mládež
permalink: /mladez/index.html
layout: layouts/page.njk
---

<section class="section">
  <div class="container">
    <h1>Fotbalové týmy Mládeže</h1>
    <p class="muted">Vyber věkovou kategorii a podívej se na zápasy a soupisku.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;">
      {% for cat in categories.items %}
        {% set catPlayers = players.youth[cat.id] | default([]) %}
        <a href="{{ ('/mladez/' ~ cat.id ~ '/') | url }}" class="card" style="text-decoration: none; color: inherit; cursor: pointer;">
          <div class="card__body" style="padding: 2rem; text-align: center;">
            <h2 class="card__title" style="margin: 0 0 0.25rem;">{{ cat.name }}</h2>
            <span style="font-size: 0.9em; color: var(--text-muted); font-weight: 600;">{{ cat.shortName }}</span>
            <p class="muted" style="margin-top: 0.5rem;">{{ catPlayers | length }} hráčů</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
