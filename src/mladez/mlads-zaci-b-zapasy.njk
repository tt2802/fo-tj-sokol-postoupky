---
title: Zápasy Mladších žáků B
permalink: /mladez/mlads-zaci-b/zapasy/index.html
layout: layouts/page.njk
---


<section class="section">
  <div class="container">
    <h1>Zápasy Mladších žáků B (U12)</h1>
    <p class="muted">Přehled všech zápasů kategorie Mladší žáci B.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% set youthMatches = matchesComputed.upcoming | where('team', 'mladez') | where('category', 'mlads-zaci-b') %}
    {% set youthPlayed = matchesComputed.played | where('team', 'mladez') | where('category', 'mlads-zaci-b') %}

    {% if youthMatches | length > 0 %}
      <h2>Nadcházející zápasy</h2>
      <div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
        {% for m in youthMatches %}
          <article class="card match-card" data-season="{{ m.season }}" data-competition="{{ m.competition }}" data-team="mladez" style="border-left: 4px solid #4CAF50;">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}{% if m.time %} · {{ m.time }}{% endif %}</p>
              <h3><strong>{{ m.home }}</strong> vs <strong>{{ m.away }}</strong></h3>
              <p class="muted">{{ m.venue }} · {{ m.competition }}</p>
              {% if m.liveUrl %}
                {% set liveEmbedId = 'live-mlads-zaci-b-' ~ m.slug %}
                <p><button type="button" class="btn btn--secondary" data-inline-video-toggle="{{ liveEmbedId }}">Sledovat živě</button></p>
                <div id="{{ liveEmbedId }}" class="video-embed" data-video-url="{{ m.liveUrl | escape }}" hidden></div>
              {% endif %}
              <p style="margin-top: 0.5rem;"><a href="{{ ('/mladez/mlads-zaci-b/zapasy/' ~ m.slug ~ '/') | url }}">Detail zápasu</a></p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if youthPlayed | length > 0 %}
      <h2>Odehrané zápasy</h2>
      <div style="display: grid; gap: 1rem;">
        {% for m in youthPlayed %}
          <article class="card match-card" data-season="{{ m.season }}" data-competition="{{ m.competition }}" data-team="mladez">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}</p>
              <h3>
                <strong>{{ m.home }}</strong>
                {% if m.homeScore is number and m.awayScore is number %}
                  <span style="color: var(--text-muted);">{{ m.homeScore }} : {{ m.awayScore }}</span>
                {% endif %}
                <strong>{{ m.away }}</strong>
              </h3>
              <p class="muted">{{ m.competition }}</p>
              {% if m.videoUrl %}
                {% set videoEmbedId = 'video-mlads-zaci-b-' ~ m.slug %}
                <p><button type="button" class="btn btn--secondary" data-inline-video-toggle="{{ videoEmbedId }}">Přehrát video</button></p>
                <div id="{{ videoEmbedId }}" class="video-embed" data-video-url="{{ m.videoUrl | escape }}" hidden></div>
              {% endif %}
              <p style="margin-top: 0.5rem;"><a href="{{ ('/mladez/mlads-zaci-b/zapasy/' ~ m.slug ~ '/') | url }}">Detail zápasu</a></p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if youthMatches | length == 0 and youthPlayed | length == 0 %}
      <p class="muted">Zatím zde nejsou žádné zápasy.</p>
    {% endif %}
  </div>
</section>

<script defer src="{{ '/assets/js/matches-filter.js' | url }}"></script>
