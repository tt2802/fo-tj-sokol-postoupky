---
title: Tým Starších žáků
permalink: /mladez/starsi-zaci/tym/index.html
layout: layouts/page.njk
---


<section class="section">
  <div class="container">
    <h1>Tým Starších žáků (U15)</h1>
    <p class="muted">Soupiska hráčů kategorie starších žáků.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Hráči</h2>

    {% set starsiZaciPlayers = players.youth["starsi-zaci"] | default([]) %}

    {% if starsiZaciPlayers | length == 0 %}
      <p class="muted">Zatím zde nejsou žádní hráči. Doplníš je v administraci v sekci „Data → Hráči – Mládež - Starší žáci".</p>
    {% else %}
      <div class="grid cards" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem;">
        {% for p in starsiZaciPlayers %}
          <article class="card">
            <div class="card__media">
              {% if p.photo %}
                <img src="{{ p.photo }}" alt="Fotka hráče {{ p.name }}" loading="lazy" decoding="async" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px 4px 0 0;">
              {% else %}
                <div style="width: 100%; aspect-ratio: 1; background: var(--bg-alt); border-radius: 4px 4px 0 0; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                  Bez fotky
                </div>
              {% endif %}
            </div>

            <div class="card__body">
              <h3 class="card__title">
                {% if p.number %}<span style="font-size: 0.8em; color: var(--text-muted);">#{{ p.number }}</span> {% endif %}{{ p.name }}
              </h3>
              {% if p.position %}
                <p class="muted">{{ p.position }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
