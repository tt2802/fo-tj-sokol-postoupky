<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Administrace | TJ Sokol Postoupky</title>
    <style>
      /* ===== MOBILE-FIRST ADMIN UI ===== */
      :root {
        --bg: #f3f5fb;
        --surface: #ffffff;
        --surface-soft: #f8fafc;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #6d28d9;
        --primary-2: #5b21b6;
        --border: #e2e8f0;
        --danger: #dc2626;
        --radius: 12px;
        --shadow: 0 8px 24px rgba(15, 23, 42, .08);
        --space-page: 12px;
      }

      html { box-sizing: border-box; }
      *, *::before, *::after { box-sizing: inherit; }

      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
        background: radial-gradient(circle at 10% -10%, #eef2ff 0%, #f8fafc 44%, #f1f5f9 100%);
        color: var(--text);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        line-height: 1.5;
      }

      #nc-root,
      #nc-root * {
        max-width: 100%;
      }

      #nc-root {
        min-height: 100dvh;
      }

      /* Header */
      #nc-root header,
      #nc-root [class*="AppHeader"],
      #nc-root [class*="AppHeaderLeader"] {
        background: rgba(15, 23, 42, .93) !important;
        backdrop-filter: blur(8px);
      }
      #nc-root header *,
      #nc-root [class*="AppHeader"] * {
        color: #f8fafc !important;
      }

      /* Main wrappers: one column on mobile */
      #nc-root [class*="AppMainContainer"],
      #nc-root [class*="AppBody"],
      #nc-root [class*="CollectionContainer"],
      #nc-root [class*="PageContainer"],
      #nc-root [class*="EditorContainer"],
      #nc-root [class*="WorkflowContainer"] {
        display: flex !important;
        flex-direction: column !important;
        width: 100% !important;
        min-width: 0 !important;
        overflow: hidden !important;
      }

      /* Mobile nav toggle */
      #mobile-nav-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        width: calc(100% - (var(--space-page) * 2));
        margin: var(--space-page);
        padding: 11px 12px;
        min-height: 44px;
        border: 0;
        border-radius: var(--radius);
        background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
        color: #f8fafc;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
      }

      /* Sidebar collapsed by default on mobile */
      #nc-root aside,
      #nc-root [class*="SidebarContainer"] {
        width: calc(100% - (var(--space-page) * 2)) !important;
        margin: 0 var(--space-page) var(--space-page) !important;
        border-radius: var(--radius) !important;
        border: 1px solid var(--border) !important;
        background: #0f172a !important;
        box-shadow: var(--shadow) !important;
        overflow: hidden !important;
        max-height: 0 !important;
        opacity: 0 !important;
        transform: translateY(-8px) !important;
        transition: max-height .25s ease, opacity .2s ease, transform .2s ease !important;
        order: 0 !important;
      }

      #nc-root.mobile-nav-open aside,
      #nc-root.mobile-nav-open [class*="SidebarContainer"] {
        max-height: 64vh !important;
        opacity: 1 !important;
        transform: translateY(0) !important;
        overflow-y: auto !important;
      }

      #nc-root aside > *,
      #nc-root [class*="SidebarContainer"] > * {
        display: flex !important;
        flex-direction: column !important;
        margin: 0 !important;
        padding: 4px 0 !important;
        list-style: none !important;
        width: 100% !important;
      }

      #nc-root aside li,
      #nc-root aside a,
      #nc-root [class*="SidebarContainer"] li,
      #nc-root [class*="SidebarContainer"] a,
      #nc-root [class*="NavItem"],
      #nc-root [class*="navItem"] {
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        min-height: 44px !important;
        width: 100% !important;
        padding: 10px 12px !important;
        font-size: 14px !important;
        color: #e5e7eb !important;
        text-decoration: none !important;
        border-bottom: 1px solid rgba(148, 163, 184, .18) !important;
      }
      #nc-root aside li:last-child,
      #nc-root [class*="SidebarContainer"] li:last-child,
      #nc-root aside a:last-child,
      #nc-root [class*="SidebarContainer"] a:last-child {
        border-bottom: 0 !important;
      }

      /* Active section highlight */
      #nc-root aside a[aria-current="page"],
      #nc-root aside a[aria-selected="true"],
      #nc-root [class*="SidebarContainer"] a[aria-current="page"],
      #nc-root [class*="SidebarContainer"] a[aria-selected="true"],
      #nc-root [class*="NavItem"][class*="active"],
      #nc-root [class*="navItem"][class*="active"] {
        background: linear-gradient(135deg, rgba(109,40,217,.28), rgba(59,130,246,.2)) !important;
        color: #fff !important;
        font-weight: 700 !important;
        border-left: 4px solid #a78bfa !important;
      }

      /* Main area */
      #nc-root main,
      #nc-root [class*="CollectionMain"],
      #nc-root [class*="MainPanel"],
      #nc-root [class*="EditorToggle"] {
        order: 1 !important;
        width: 100% !important;
        min-width: 0 !important;
        padding: var(--space-page) !important;
        overflow-x: hidden !important;
      }

      /* Panels and cards */
      #nc-root [class*="EntryCard"],
      #nc-root [class*="ListEntry"],
      #nc-root [class*="GridCard"],
      #nc-root [class*="MediaCard"],
      #nc-root [class*="FieldWrapper"],
      #nc-root [class*="FormField"] {
        border-radius: var(--radius) !important;
      }

      #nc-root [class*="EntryCard"],
      #nc-root [class*="ListEntry"],
      #nc-root [class*="GridCard"],
      #nc-root [class*="MediaCard"] {
        border: 1px solid var(--border) !important;
        background: var(--surface) !important;
        box-shadow: var(--shadow) !important;
      }

      /* Forms */
      #nc-root label,
      #nc-root [class*="FieldLabel"] {
        display: block !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        margin: 0 0 6px !important;
      }

      #nc-root input,
      #nc-root select,
      #nc-root textarea {
        width: 100% !important;
        max-width: 100% !important;
        min-height: 44px !important;
        font-size: 16px !important;
        padding: 10px 12px !important;
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        background: #fff !important;
        color: var(--text) !important;
      }

      #nc-root textarea {
        min-height: 110px !important;
      }

      #nc-root input:focus,
      #nc-root select:focus,
      #nc-root textarea:focus {
        outline: none !important;
        border-color: #8b5cf6 !important;
        box-shadow: 0 0 0 3px rgba(139,92,246,.18) !important;
      }

      #nc-root [class*="FieldWrapper"],
      #nc-root [class*="field-wrapper"],
      #nc-root [class*="FormField"],
      #nc-root [class*="widgetControl"] {
        width: 100% !important;
        margin-bottom: 14px !important;
      }

      /* Buttons */
      #nc-root button,
      #nc-root [role="button"] {
        min-height: 44px !important;
        min-width: 44px !important;
        border-radius: 10px !important;
      }

      /* Action toolbars on mobile: stack vertically */
      #nc-root [class*="Toolbar"],
      #nc-root [class*="EditorToolbar"],
      #nc-root [class*="controls"],
      #nc-root [class*="Actions"] {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 10px !important;
      }

      #nc-root [class*="Toolbar"] button,
      #nc-root [class*="EditorToolbar"] button,
      #nc-root [class*="Actions"] button {
        width: 100% !important;
        font-size: 14px !important;
        padding: 10px 14px !important;
      }

      /* Primary actions */
      #nc-root button[data-test*="save"],
      #nc-root button[data-test*="publish"],
      #nc-root button[data-test*="new"],
      #nc-root button[data-test*="login"],
      #nc-root [class*="Toolbar"] button[class*="primary"] {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-2) 100%) !important;
        color: #fff !important;
        border: 0 !important;
        box-shadow: 0 6px 16px rgba(109,40,217,.28) !important;
      }

      /* Tables -> cards on mobile */
      #nc-root table {
        width: 100% !important;
        border-collapse: separate !important;
      }

      #nc-root table thead {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
        clip: rect(0 0 0 0) !important;
      }

      #nc-root table,
      #nc-root tbody,
      #nc-root tr,
      #nc-root td {
        display: block !important;
        width: 100% !important;
      }

      #nc-root tr {
        background: var(--surface) !important;
        border: 1px solid var(--border) !important;
        border-radius: var(--radius) !important;
        box-shadow: var(--shadow) !important;
        margin: 0 0 12px !important;
        padding: 8px 10px !important;
      }

      #nc-root td {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        gap: 10px !important;
        border: 0 !important;
        padding: 8px 0 !important;
        min-height: 36px;
      }

      #nc-root td::before {
        content: attr(data-label);
        font-weight: 700;
        color: var(--muted);
        font-size: 12px;
        flex: 0 0 45%;
      }

      /* Floating helper panels */
      #recent-changes-toggle,
      #status-dot {
        font-size: 12px !important;
        padding: 9px 12px !important;
        bottom: 14px !important;
      }
      #recent-changes-toggle { right: 14px !important; }
      #status-dot { left: 14px !important; }

      #recent-changes-panel,
      #status-panel {
        width: calc(100vw - 16px) !important;
        max-height: 56vh !important;
        bottom: 62px !important;
      }
      #recent-changes-panel { right: 8px !important; }
      #status-panel { left: 8px !important; }

      /* Text readability */
      #nc-root h1, #nc-root h2, #nc-root h3 { line-height: 1.25; }
      #nc-root h1 { font-size: 1.35rem !important; }
      #nc-root h2 { font-size: 1.2rem !important; }
      #nc-root h3 { font-size: 1.05rem !important; }
      #nc-root p, #nc-root span, #nc-root td, #nc-root th {
        word-break: break-word !important;
        overflow-wrap: break-word !important;
      }

      /* <=480px (small phones) */
      @media (max-width: 480px) {
        :root { --space-page: 10px; }

        #mobile-nav-toggle {
          font-size: 13px;
          padding: 10px;
        }

        #nc-root h1 { font-size: 1.2rem !important; }
        #nc-root h2 { font-size: 1.08rem !important; }

        #nc-root input,
        #nc-root select,
        #nc-root textarea,
        #nc-root button {
          font-size: 15px !important;
        }
      }

      /* 481px - 768px (phones / small tablets) */
      @media (min-width: 481px) and (max-width: 768px) {
        :root { --space-page: 14px; }
      }

      /* >=1024px desktop */
      @media (min-width: 1024px) {
        :root { --space-page: 18px; }

        #mobile-nav-toggle {
          display: none !important;
        }

        #nc-root [class*="AppMainContainer"],
        #nc-root [class*="CollectionContainer"],
        #nc-root [class*="PageContainer"],
        #nc-root [class*="EditorContainer"] {
          flex-direction: row !important;
          align-items: stretch !important;
        }

        #nc-root aside,
        #nc-root [class*="SidebarContainer"] {
          width: 290px !important;
          max-width: 290px !important;
          min-width: 240px !important;
          margin: 0 !important;
          border-radius: 0 !important;
          border-right: 1px solid rgba(148,163,184,.2) !important;
          border-bottom: 0 !important;
          max-height: none !important;
          opacity: 1 !important;
          transform: none !important;
          overflow-y: auto !important;
        }

        #nc-root aside > *,
        #nc-root [class*="SidebarContainer"] > * {
          padding-top: 8px !important;
        }

        #nc-root main,
        #nc-root [class*="CollectionMain"],
        #nc-root [class*="MainPanel"],
        #nc-root [class*="EditorToggle"] {
          padding: 18px !important;
        }

        /* Desktop tabulky vrátit normálně */
        #nc-root table,
        #nc-root tbody,
        #nc-root tr,
        #nc-root td,
        #nc-root th,
        #nc-root table thead {
          display: revert !important;
        }

        #nc-root td::before {
          content: none !important;
        }
      }
    </style>
  </head>
  <body>
    <script>window.CMS_MANUAL_INIT = true;</script>
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
    <script src="./autofill-plugin.js?v=20260408"></script>
    <script>
    /* ── Mobile layout fixer ── */
    (function () {
      if (window.innerWidth > 768) return;

      var NAV_STATE_KEY = "admin_mobile_nav_open";

      function setOpen(root, btn, open) {
        if (!root || !btn) return;
        if (open) root.classList.add("mobile-nav-open");
        else root.classList.remove("mobile-nav-open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        var ch = document.getElementById("mobile-nav-chevron");
        if (ch) ch.textContent = open ? "▴" : "▾";
        try { localStorage.setItem(NAV_STATE_KEY, open ? "1" : "0"); } catch (e) {}
      }

      function bindAutoClose(root, btn) {
        if (root.__mobileNavAutocloseBound) return;
        root.addEventListener("click", function (e) {
          var target = e.target;
          if (!target) return;
          var link = target.closest("aside a, [class*='SidebarContainer'] a, [class*='NavItem']");
          if (!link) return;
          // Na mobilu po kliknutí do sekce menu zavřít, ať nepřekáží obsahu
          setTimeout(function () { setOpen(root, btn, false); }, 120);
        });
        root.__mobileNavAutocloseBound = true;
      }

      function applyTableCardLabels(root) {
        var tables = root.querySelectorAll("table");
        tables.forEach(function (table) {
          var headers = Array.from(table.querySelectorAll("thead th")).map(function (th) {
            return (th.textContent || "").trim();
          });

          if (!headers.length) return;

          var rows = table.querySelectorAll("tbody tr");
          rows.forEach(function (tr) {
            var cells = tr.querySelectorAll("td");
            cells.forEach(function (td, index) {
              if (!td.getAttribute("data-label")) {
                td.setAttribute("data-label", headers[index] || "Hodnota");
              }
            });
          });
        });
      }

      function ensureToggle(root) {
        var existing = document.getElementById("mobile-nav-toggle");
        if (existing) return existing;

        var btn = document.createElement("button");
        btn.id = "mobile-nav-toggle";
        btn.type = "button";
        btn.setAttribute("aria-expanded", "false");
        btn.innerHTML = '<span>📂 Sekce</span><span id="mobile-nav-chevron">▾</span>';

        btn.addEventListener("click", function () {
          var open = !root.classList.contains("mobile-nav-open");
          setOpen(root, btn, open);
        });

        root.insertBefore(btn, root.firstChild);
        bindAutoClose(root, btn);
        btn.__autocloseBound = true;

        // obnov stav z localStorage
        var savedOpen = false;
        try { savedOpen = localStorage.getItem(NAV_STATE_KEY) === "1"; } catch (e) {}
        setOpen(root, btn, savedOpen);

        return btn;
      }

      function fix() {
        var root = document.getElementById("nc-root");
        if (!root) return;

        var toggleBtn = ensureToggle(root);
        if (toggleBtn) bindAutoClose(root, toggleBtn);

        // 1. AppMainContainer: flex obálka → sloupec
        var containers = root.querySelectorAll(
          "[class*='AppMainContainer'],[class*='AppBody']," +
          "[class*='CollectionContainer'],[class*='PageContainer']," +
          "[class*='EditorContainer'],[class*='WorkflowContainer']"
        );
        containers.forEach(function(el) {
          el.style.flexDirection = "column";
          el.style.width = "100%";
          el.style.overflow = "hidden";
        });

        // 2. SidebarContainer / aside → vertikální panel
        var sidebar = root.querySelector("aside, [class*='SidebarContainer']");
        if (sidebar) {
          sidebar.style.display = "block";
          sidebar.style.width = "100%";
          sidebar.style.maxWidth = "100%";
          sidebar.style.order = "0";

          // Vnitřní wrappery sloupcově
          Array.from(sidebar.children).forEach(function(child) {
            child.style.display = "flex";
            child.style.flexDirection = "column";
            child.style.alignItems = "stretch";
            child.style.width = "100%";
          });
        }

        // 3. CollectionMain / main → plná šířka pod sidebarem
        var main = root.querySelector("main, [class*='CollectionMain']");
        if (main) {
          main.style.width = "100%";
          main.style.maxWidth = "100vw";
          main.style.minWidth = "0";
          main.style.overflowX = "hidden";
          main.style.order = "1";
          main.style.flex = "1 1 auto";
        }

        // 4. Tabulky na mobilu jako karty s popisky hodnot
        applyTableCardLabels(root);
      }

      // Spustit ihned i periodicky (CMS se re-renderuje při navigaci)
      fix();
      setInterval(fix, 1000);
      window.addEventListener("hashchange", function () { setTimeout(fix, 300); });
      window.addEventListener("popstate", function () { setTimeout(fix, 300); });
    })();
    </script>
    <script>
    (function () {
      var REPO = "tt2802/fo-tj-sokol-postoupky";
      var API  = "https://api.github.com/repos/" + REPO + "/commits?per_page=10";
      var PANEL_ID = "recent-changes-panel";
      var TOGGLE_ID = "recent-changes-toggle";
      var injected = false;
      var panelOpen = false;

      function formatDate(iso) {
        var d = new Date(iso);
        return d.toLocaleDateString("cs-CZ", { day: "numeric", month: "numeric" })
          + " " + d.toLocaleTimeString("cs-CZ", { hour: "2-digit", minute: "2-digit" });
      }

      function shortenMsg(msg) {
        var first = (msg || "").split("\n")[0];
        return first.length > 55 ? first.slice(0, 52) + "…" : first;
      }

      function typeIcon(msg) {
        var m = (msg || "").toLowerCase();
        if (m.indexOf("novink") > -1 || m.indexOf("news") > -1 || m.indexOf("článek") > -1) return "📰";
        if (m.indexOf("zápas") > -1 || m.indexOf("match") > -1 || m.indexOf("score") > -1) return "⚽";
        if (m.indexOf("hráč") > -1 || m.indexOf("player") > -1 || m.indexOf("tým") > -1) return "👤";
        if (m.indexOf("galeri") > -1 || m.indexOf("foto") > -1) return "🖼️";
        if (m.indexOf("admin") > -1 || m.indexOf("cms") > -1) return "⚙️";
        return "📝";
      }

      function injectPanel() {
        if (injected) return;
        injected = true;
        var isMobile = window.innerWidth <= 768;

        // Toggle button (fixed, bottom-right)
        var toggle = document.createElement("button");
        toggle.id = TOGGLE_ID;
        toggle.type = "button";
        toggle.textContent = "📋 Změny";
        toggle.style.cssText = "position:fixed;bottom:" + (isMobile ? "12px" : "20px") + ";right:" + (isMobile ? "12px" : "20px") + ";z-index:9999;padding:8px 16px;font-size:13px;font-weight:600;border:none;border-radius:20px;background:#6d28d9;color:#fff;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.2);transition:transform .15s;";
        toggle.onmouseenter = function () { toggle.style.transform = "scale(1.05)"; };
        toggle.onmouseleave = function () { toggle.style.transform = "scale(1)"; };
        toggle.onclick = function () {
          var p = document.getElementById(PANEL_ID);
          if (p) {
            panelOpen = !panelOpen;
            p.style.display = panelOpen ? "block" : "none";
          }
        };
        document.body.appendChild(toggle);

        // Side panel (fixed, bottom-right, above button)
        var panel = document.createElement("div");
        panel.id = PANEL_ID;
        panel.style.cssText = "display:none;position:fixed;bottom:60px;right:" + (isMobile ? "10px" : "20px") + ";z-index:9998;width:" + (isMobile ? "calc(100vw - 20px)" : "320px") + ";max-height:" + (isMobile ? "60vh" : "420px") + ";overflow-y:auto;padding:14px 16px;background:#fff;border:1px solid #e0e0e0;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);font-family:system-ui,-apple-system,sans-serif;";
        panel.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;"><span style="font-weight:700;font-size:14px;color:#333;">Poslední změny</span><button id="rc-close" type="button" style="border:none;background:none;cursor:pointer;font-size:18px;color:#999;padding:0 2px;">×</button></div><div id="recent-changes-list" style="color:#888;font-size:13px;">Načítám…</div>';
        document.body.appendChild(panel);

        document.getElementById("rc-close").onclick = function () {
          panelOpen = false;
          panel.style.display = "none";
        };

        fetch(API)
          .then(function (r) { return r.json(); })
          .then(function (commits) {
            if (!Array.isArray(commits)) {
              document.getElementById("recent-changes-list").textContent = "Nepodařilo se načíst.";
              return;
            }
            var html = '<div style="display:flex;flex-direction:column;gap:6px;">';
            commits.forEach(function (c) {
              var msg = c.commit && c.commit.message || "";
              var date = c.commit && c.commit.author && c.commit.author.date || "";
              var sha = (c.sha || "").slice(0, 7);
              var url = c.html_url || "#";
              html += '<div style="padding:6px 8px;background:#fafafa;border-radius:5px;border:1px solid #f0f0f0;">'
                + '<div style="display:flex;align-items:center;gap:6px;">'
                + '<span style="font-size:14px;flex-shrink:0;">' + typeIcon(msg) + '</span>'
                + '<span style="font-size:12px;color:#222;line-height:1.3;overflow:hidden;text-overflow:ellipsis;">' + shortenMsg(msg).replace(/</g,"&lt;") + '</span>'
                + '</div>'
                + '<div style="font-size:11px;color:#999;margin-top:2px;padding-left:22px;">'
                + formatDate(date)
                + ' · <a href="' + url + '" target="_blank" rel="noopener" style="color:#6d28d9;text-decoration:none;">' + sha + '</a>'
                + '</div></div>';
            });
            html += '</div>';
            document.getElementById("recent-changes-list").innerHTML = html;
          })
          .catch(function () {
            document.getElementById("recent-changes-list").textContent = "Nepodařilo se načíst.";
          });
      }

      // Wait for CMS to render, then inject
      var attempts = 0;
      var timer = setInterval(function () {
        var body = document.querySelector("main") || document.querySelector("[class*='Main']");
        if (body || ++attempts > 40) { clearInterval(timer); injectPanel(); }
      }, 500);
    })();

    /* ── Status Monitor: deploy & site health check ── */
    (function () {
      var REPO = "tt2802/fo-tj-sokol-postoupky";
      var SITE = "https://tt2802.github.io/fo-tj-sokol-postoupky/";
      var GH_API = "https://api.github.com/repos/" + REPO;
      var STATUS_ID = "status-panel";
      var STATUS_DOT = "status-dot";
      var injected = false;
      var panelOpen = false;

      function timeAgo(iso) {
        var diff = (Date.now() - new Date(iso).getTime()) / 1000;
        if (diff < 60) return "právě teď";
        if (diff < 3600) return Math.floor(diff / 60) + " min";
        if (diff < 86400) return Math.floor(diff / 3600) + " hod";
        return Math.floor(diff / 86400) + " dní";
      }

      function fmtDate(iso) {
        var d = new Date(iso);
        return d.toLocaleDateString("cs-CZ") + " " + d.toLocaleTimeString("cs-CZ", { hour: "2-digit", minute: "2-digit" });
      }

      function row(label, val, color) {
        return '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #f0f0f0;">'
          + '<span style="font-size:12px;color:#666;">' + label + '</span>'
          + '<span style="font-size:12px;font-weight:600;color:' + (color || "#222") + ';">' + val + '</span></div>';
      }

      function statusBadge(text, bg, fg) {
        return '<span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;background:' + bg + ';color:' + fg + ';">' + text + '</span>';
      }

      function inject() {
        if (injected) return;
        injected = true;
        var isMobile = window.innerWidth <= 768;

        // Dot indicator button (fixed, bottom-left)
        var dot = document.createElement("button");
        dot.id = STATUS_DOT;
        dot.type = "button";
        dot.innerHTML = "● Stav";
        dot.style.cssText = "position:fixed;bottom:" + (isMobile ? "12px" : "20px") + ";left:" + (isMobile ? "12px" : "20px") + ";z-index:9999;padding:8px 16px;font-size:13px;font-weight:600;border:none;border-radius:20px;background:#374151;color:#fbbf24;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.2);transition:transform .15s;";
        dot.onmouseenter = function () { dot.style.transform = "scale(1.05)"; };
        dot.onmouseleave = function () { dot.style.transform = "scale(1)"; };
        dot.onclick = function () {
          var p = document.getElementById(STATUS_ID);
          if (p) { panelOpen = !panelOpen; p.style.display = panelOpen ? "block" : "none"; }
        };
        document.body.appendChild(dot);

        // Panel
        var panel = document.createElement("div");
        panel.id = STATUS_ID;
        panel.style.cssText = "display:none;position:fixed;bottom:60px;left:" + (isMobile ? "10px" : "20px") + ";z-index:9998;width:" + (isMobile ? "calc(100vw - 20px)" : "320px") + ";padding:16px;background:#fff;border:1px solid #e0e0e0;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);font-family:system-ui,-apple-system,sans-serif;";
        panel.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">'
          + '<span style="font-weight:700;font-size:14px;color:#333;">Stav webu</span>'
          + '<button id="st-close" type="button" style="border:none;background:none;cursor:pointer;font-size:18px;color:#999;padding:0 2px;">×</button></div>'
          + '<div id="status-content" style="font-size:13px;color:#888;">Kontroluji…</div>';
        document.body.appendChild(panel);

        document.getElementById("st-close").onclick = function () {
          panelOpen = false;
          panel.style.display = "none";
        };

        // Run checks
        runChecks();
      }

      function runChecks() {
        var results = { commit: null, deploy: null, siteOk: null };

        // 1. Latest commit
        var p1 = fetch(GH_API + "/commits?per_page=1")
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (Array.isArray(data) && data[0]) {
              results.commit = {
                sha: data[0].sha,
                date: data[0].commit.author.date,
                msg: (data[0].commit.message || "").split("\n")[0]
              };
            }
          }).catch(function () {});

        // 2. Latest GitHub Pages deployment (via deployments API)
        var p2 = fetch(GH_API + "/pages/builds/latest")
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data && data.status) {
              results.deploy = {
                status: data.status,
                created: data.created_at,
                updated: data.updated_at,
                commitSha: data.commit ? data.commit.substring(0, 7) : ""
              };
            }
          }).catch(function () {
            // Try actions workflow runs as fallback
            return fetch(GH_API + "/actions/runs?per_page=1&status=completed")
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (data && data.workflow_runs && data.workflow_runs[0]) {
                  var run = data.workflow_runs[0];
                  results.deploy = {
                    status: run.conclusion === "success" ? "built" : run.conclusion,
                    created: run.created_at,
                    updated: run.updated_at,
                    commitSha: (run.head_sha || "").substring(0, 7)
                  };
                }
              }).catch(function () {});
          });

        // 3. Site ping
        var p3 = fetch(SITE, { method: "HEAD", cache: "no-store", mode: "no-cors" })
          .then(function () { results.siteOk = true; })
          .catch(function () { results.siteOk = false; });

        Promise.all([p1, p2, p3]).then(function () {
          renderStatus(results);
        });
      }

      function renderStatus(r) {
        var html = '';

        // Overall status
        var allGood = r.siteOk !== false;
        var deployOk = r.deploy && (r.deploy.status === "built" || r.deploy.status === "success");
        var synced = true;

        if (r.commit && r.deploy && r.deploy.commitSha) {
          synced = r.commit.sha.substring(0, 7) === r.deploy.commitSha;
        }

        var overallOk = allGood && deployOk !== false;

        // Status header
        if (overallOk && synced) {
          html += '<div style="text-align:center;padding:8px 0 12px;">'
            + '<div style="font-size:28px;">✅</div>'
            + '<div style="font-size:13px;font-weight:600;color:#16a34a;margin-top:4px;">Vše v pořádku</div></div>';
        } else if (!synced) {
          html += '<div style="text-align:center;padding:8px 0 12px;">'
            + '<div style="font-size:28px;">🔄</div>'
            + '<div style="font-size:13px;font-weight:600;color:#d97706;margin-top:4px;">Probíhá nasazení…</div></div>';
        } else {
          html += '<div style="text-align:center;padding:8px 0 12px;">'
            + '<div style="font-size:28px;">⚠️</div>'
            + '<div style="font-size:13px;font-weight:600;color:#dc2626;margin-top:4px;">Problém s nasazením</div></div>';
        }

        // Web status
        if (r.siteOk === true) {
          html += row("Web", statusBadge("Online", "#dcfce7", "#16a34a"));
        } else if (r.siteOk === false) {
          html += row("Web", statusBadge("Nedostupný", "#fecaca", "#dc2626"));
        } else {
          html += row("Web", statusBadge("Neznámý", "#f3f4f6", "#6b7280"));
        }

        // Deploy status
        if (r.deploy) {
          var dLabel = r.deploy.status === "built" || r.deploy.status === "success" ? "Nasazeno" : r.deploy.status === "building" || r.deploy.status === "queued" ? "Probíhá" : r.deploy.status;
          var dBg = dLabel === "Nasazeno" ? "#dcfce7" : dLabel === "Probíhá" ? "#fef3c7" : "#fecaca";
          var dFg = dLabel === "Nasazeno" ? "#16a34a" : dLabel === "Probíhá" ? "#d97706" : "#dc2626";
          html += row("GitHub Pages", statusBadge(dLabel, dBg, dFg));
          html += row("Naposledy nasazeno", timeAgo(r.deploy.updated || r.deploy.created));
        } else {
          html += row("GitHub Pages", statusBadge("Neznámý", "#f3f4f6", "#6b7280"));
        }

        // Sync status
        if (r.commit && r.deploy && r.deploy.commitSha) {
          if (synced) {
            html += row("Synchronizace", statusBadge("Aktuální", "#dcfce7", "#16a34a"));
          } else {
            html += row("Synchronizace", statusBadge("Čeká na deploy", "#fef3c7", "#d97706"));
          }
        }

        // Latest commit
        if (r.commit) {
          html += '<div style="margin-top:10px;padding:8px 10px;background:#f8fafc;border-radius:6px;border:1px solid #e2e8f0;">'
            + '<div style="font-size:11px;color:#94a3b8;margin-bottom:4px;">Poslední commit</div>'
            + '<div style="font-size:12px;color:#334155;line-height:1.4;">' + r.commit.msg.replace(/</g, "&lt;").substring(0, 60) + '</div>'
            + '<div style="font-size:11px;color:#94a3b8;margin-top:2px;">' + fmtDate(r.commit.date) + ' · ' + r.commit.sha.substring(0, 7) + '</div></div>';
        }

        // Refresh button
        html += '<div style="text-align:center;margin-top:12px;">'
          + '<button id="st-refresh" type="button" style="padding:6px 16px;font-size:12px;border:1px solid #e0e0e0;border-radius:6px;background:#fff;color:#333;cursor:pointer;font-weight:500;">🔄 Obnovit</button></div>';

        var el = document.getElementById("status-content");
        if (el) el.innerHTML = html;

        // Bind refresh
        var btn = document.getElementById("st-refresh");
        if (btn) btn.onclick = function () {
          el.innerHTML = '<div style="text-align:center;color:#888;padding:10px;">Kontroluji…</div>';
          runChecks();
        };

        // Update dot color
        var dot = document.getElementById(STATUS_DOT);
        if (dot) {
          if (overallOk && synced) {
            dot.style.color = "#22c55e";
            dot.style.background = "#1e3a2f";
          } else if (!synced) {
            dot.style.color = "#fbbf24";
            dot.style.background = "#374151";
          } else {
            dot.style.color = "#ef4444";
            dot.style.background = "#3b1520";
          }
        }
      }

      // Inject after CMS loads
      var att = 0;
      var tm = setInterval(function () {
        var body = document.querySelector("main") || document.querySelector("[class*='Main']");
        if (body || ++att > 40) { clearInterval(tm); inject(); }
      }, 600);
    })();
    </script>
  </body>
</html>
