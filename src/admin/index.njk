<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Administrace | TJ Sokol Postoupky</title>
    <style>
      /* CSS proměnné – globálně dostupné ve všech media query */
      :root {
        --bg: #f4f6fb;
        --surface: #ffffff;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #6d28d9;
        --primary-2: #4f46e5;
        --danger: #dc2626;
        --border: #e2e8f0;
        --radius: 12px;
        --shadow: 0 8px 24px rgba(15, 23, 42, .08);
        --space: 12px;
        --mobile-safe-bottom: env(safe-area-inset-bottom, 0px);
      }

      html { box-sizing: border-box; }
      *, *::before, *::after { box-sizing: inherit; }

      html,
      body,
      #nc-root {
        min-height: 100vh;
        min-height: 100dvh;
      }

      /* =============================================
         MOBILNÍ STYLY – pouze pro telefony a tablety
         Na počítači (> 768 px) se nic nemění.
         ============================================= */
      @media (max-width: 768px), ((hover: none) and (pointer: coarse) and (max-width: 900px)) {

        html, body {
          margin: 0;
          padding: 0;
          width: 100%;
          max-width: 100%;
          overflow-x: hidden;
          -webkit-overflow-scrolling: touch;
        }

        body {
          padding-bottom: calc(96px + var(--mobile-safe-bottom)) !important;
        }

        #nc-root,
        #nc-root * {
          max-width: 100%;
        }

        #nc-root {
          padding-bottom: calc(92px + var(--mobile-safe-bottom)) !important;
        }

        /* Hlavní wrappers – sloupec na mobilu */
        #nc-root [class*="AppMainContainer"],
        #nc-root [class*="AppBody"],
        #nc-root [class*="CollectionContainer"],
        #nc-root [class*="PageContainer"],
        #nc-root [class*="EditorContainer"],
        #nc-root [class*="WorkflowContainer"] {
          display: flex !important;
          flex-direction: column !important;
          min-width: 0 !important;
          width: 100% !important;
          overflow-x: hidden !important;
          overflow-y: visible !important;
        }

        /* Postranní panel → horizontální proužek nahoře */
        #nc-root aside,
        #nc-root [class*="SidebarContainer"] {
          order: 0 !important;
          position: sticky !important;
          top: 0 !important;
          z-index: 120 !important;
          width: 100% !important;
          margin: 0 !important;
          border-radius: 0 !important;
          border: 0 !important;
          border-bottom: 1px solid rgba(148, 163, 184, .2) !important;
          background: #0f172a !important;
          box-shadow: var(--shadow) !important;
          overflow-x: hidden !important;
          overflow-y: visible !important;
          -webkit-overflow-scrolling: touch !important;
          min-height: 0 !important;
          max-height: none !important;
          padding: 4px 6px !important;
          pointer-events: auto !important;
          touch-action: pan-x pan-y !important;
        }

        #nc-root aside > *,
        #nc-root [class*="SidebarContainer"] > * {
          width: 100% !important;
          min-width: 0 !important;
          max-width: 100% !important;
        }

        #nc-root aside ul,
        #nc-root [class*="SidebarContainer"] ul,
        #nc-root [class*="Nav"] ul {
          display: flex !important;
          flex-direction: row !important;
          flex-wrap: nowrap !important;
          align-items: center !important;
          gap: 6px !important;
          list-style: none !important;
          margin: 0 !important;
          padding: 4px 0 !important;
          width: 100% !important;
          max-width: 100% !important;
          overflow-x: auto !important;
          overflow-y: hidden !important;
          -webkit-overflow-scrolling: touch !important;
          scrollbar-width: thin;
          position: relative !important;
          z-index: 121 !important;
          pointer-events: auto !important;
        }

        #nc-root aside li,
        #nc-root [class*="SidebarContainer"] li,
        #nc-root [class*="NavItem"] {
          position: relative !important;
          z-index: 122 !important;
          flex: 0 0 auto !important;
          pointer-events: auto !important;
        }

        #nc-root aside li,
        #nc-root aside a,
        #nc-root [class*="SidebarContainer"] li,
        #nc-root [class*="SidebarContainer"] a,
        #nc-root [class*="NavItem"],
        #nc-root [class*="navItem"] {
          display: inline-flex !important;
          align-items: center !important;
          gap: 8px !important;
          width: auto !important;
          min-height: 40px !important;
          padding: 8px 12px !important;
          border-radius: 999px !important;
          color: #e2e8f0 !important;
          font-size: 13px !important;
          text-decoration: none !important;
          border-bottom: 0 !important;
          white-space: nowrap !important;
          position: relative !important;
          z-index: 123 !important;
          pointer-events: auto !important;
          touch-action: manipulation !important;
        }

        #nc-root aside a[aria-current="page"],
        #nc-root [class*="SidebarContainer"] a[aria-current="page"] {
          color: #fff !important;
          font-weight: 700 !important;
          background: linear-gradient(135deg, rgba(109,40,217,.35), rgba(59,130,246,.22)) !important;
          border-left: 0 !important;
        }

        /* Hlavní obsah */
        #nc-root main,
        #nc-root [class*="CollectionMain"],
        #nc-root [class*="MainPanel"],
        #nc-root [class*="EditorToggle"] {
          order: 1 !important;
          position: relative !important;
          z-index: 1 !important;
          min-width: 0 !important;
          width: 100% !important;
          padding: var(--space) !important;
          padding-bottom: calc(104px + var(--mobile-safe-bottom)) !important;
          overflow-x: hidden !important;
          overflow-y: visible !important;
        }

        /* Telefon: skrýt search (zlobí v adminu) */
        #nc-root aside [class*="Search"],
        #nc-root [class*="SidebarContainer"] [class*="Search"],
        #nc-root [class*="CollectionTop"] [class*="Search"],
        #nc-root [class*="CollectionTop"] input[type="search"],
        #nc-root [class*="CollectionTop"] [role="search"],
        #nc-root [data-testid*="search"] {
          display: none !important;
          visibility: hidden !important;
          max-height: 0 !important;
          overflow: hidden !important;
        }

        /* Vnořené editory (hráči, kalendář, listy, relation položky) */
        #nc-root [class*="SplitPane"],
        #nc-root [class*="EditorSplitPane"],
        #nc-root [class*="EditorContainer"],
        #nc-root [class*="EditorMain"] {
          display: flex !important;
          flex-direction: column !important;
          min-width: 0 !important;
          width: 100% !important;
        }

        #nc-root [class*="ListControl"],
        #nc-root [class*="ListControlItem"],
        #nc-root [class*="ObjectControl"],
        #nc-root [class*="ObjectWidget"],
        #nc-root [class*="RelationControl"],
        #nc-root [class*="CardsGrid"],
        #nc-root [class*="CardGrid"],
        #nc-root [class*="Sortable"],
        #nc-root [class*="Nested"] {
          min-width: 0 !important;
          width: 100% !important;
          max-width: 100% !important;
        }

        #nc-root [class*="ListControlItem"],
        #nc-root [class*="ObjectControl"],
        #nc-root [class*="Sortable"] [class*="Item"],
        #nc-root [class*="CardGrid"] > * {
          padding: 10px !important;
          border-radius: 10px !important;
          overflow: hidden !important;
          margin-bottom: 12px !important;
        }

        #nc-root [class*="ListControlItem"] [class*="TopBar"],
        #nc-root [class*="ListControlItem"] [class*="Toolbar"],
        #nc-root [class*="ObjectControl"] [class*="Toolbar"] {
          display: flex !important;
          align-items: center !important;
          justify-content: space-between !important;
          gap: 8px !important;
          flex-wrap: wrap !important;
        }

        #nc-root [class*="ListControlItem"] [class*="TopBar"] button,
        #nc-root [class*="ListControlItem"] [class*="Toolbar"] button,
        #nc-root [class*="ObjectControl"] [class*="Toolbar"] button {
          width: auto !important;
          min-width: 40px !important;
          min-height: 40px !important;
          padding: 8px 10px !important;
        }

        #nc-root [class*="CollectionMain"] > *,
        #nc-root [class*="MainPanel"] > *,
        #nc-root [class*="EditorContainer"] > * {
          min-width: 0 !important;
          max-width: 100% !important;
        }

        /* Formuláře */
        #nc-root input,
        #nc-root select,
        #nc-root textarea,
        #nc-root [contenteditable="true"] {
          width: 100% !important;
          max-width: 100% !important;
          min-height: 44px !important;
          padding: 12px 14px !important;
          font-size: 16px !important;
          border-radius: 10px !important;
        }

        #nc-root textarea { min-height: 120px !important; }

        /* Dotykové cíle */
        #nc-root button,
        #nc-root a,
        #nc-root [role="button"] {
          min-height: 44px !important;
        }

        #nc-root button,
        #nc-root [role="button"] {
          min-width: 44px !important;
          border-radius: 10px !important;
        }

        /* Tlačítka akcí – sloupec */
        #nc-root [class*="Toolbar"],
        #nc-root [class*="EditorToolbar"],
        #nc-root [class*="Actions"],
        #nc-root [class*="controls"] {
          display: flex !important;
          flex-direction: column !important;
          align-items: stretch !important;
          gap: 12px !important;
        }

        #nc-root [class*="Toolbar"] button,
        #nc-root [class*="EditorToolbar"] button,
        #nc-root [class*="Actions"] button {
          width: 100% !important;
          padding: 12px 16px !important;
          font-size: 14px !important;
        }

        /* Media widgety */
        #nc-root [class*="MediaLibrary"],
        #nc-root [class*="FileUpload"],
        #nc-root [class*="imageWidget"] {
          width: 100% !important;
        }

        /* Tabulky → karty */
        #nc-root table {
          width: 100% !important;
          border-collapse: separate !important;
        }

        #nc-root table thead {
          position: absolute !important;
          width: 1px !important;
          height: 1px !important;
          overflow: hidden !important;
          clip: rect(0 0 0 0) !important;
        }

        #nc-root table,
        #nc-root tbody,
        #nc-root tr,
        #nc-root td {
          display: block !important;
          width: 100% !important;
        }

        #nc-root tr {
          margin-bottom: 12px !important;
          padding: 8px 10px !important;
          border: 1px solid var(--border) !important;
          border-radius: var(--radius) !important;
          background: var(--surface) !important;
          box-shadow: var(--shadow) !important;
        }

        #nc-root td {
          display: flex !important;
          justify-content: space-between !important;
          align-items: center !important;
          gap: 10px !important;
          border: 0 !important;
          padding: 8px 0 !important;
        }

        #nc-root td[data-label]::before {
          content: attr(data-label);
          font-size: 12px;
          font-weight: 700;
          color: var(--muted);
          flex: 0 0 45%;
        }

        #nc-root td > * {
          min-width: 0 !important;
          max-width: 100% !important;
        }

        /* Nadpisy */
        #nc-root h1, #nc-root h2, #nc-root h3 {
          line-height: 1.25;
        }
        #nc-root h1 { font-size: 1.28rem !important; }
        #nc-root h2 { font-size: 1.12rem !important; }
        #nc-root h3 { font-size: 1.02rem !important; }

        #nc-root p,
        #nc-root span,
        #nc-root td,
        #nc-root th {
          word-break: break-word !important;
          overflow-wrap: break-word !important;
        }

        /* Plovoucí tlačítka */
        #recent-changes-toggle,
        #status-dot {
          font-size: 12px !important;
          padding: 9px 12px !important;
          bottom: calc(10px + var(--mobile-safe-bottom)) !important;
          z-index: 1600 !important;
        }
        #recent-changes-toggle { right: 10px !important; }
        #status-dot { left: 10px !important; }

        #recent-changes-panel,
        #status-panel {
          width: calc(100vw - 20px) !important;
          max-width: calc(100vw - 20px) !important;
          max-height: min(70dvh, 520px) !important;
          bottom: calc(54px + var(--mobile-safe-bottom)) !important;
          left: 10px !important;
          right: 10px !important;
        }

      } /* konec @media (max-width: 768px) */

      /* Velmi malé obrazovky */
      @media (max-width: 480px) {
        :root { --space: 10px; }
        #nc-root h1 { font-size: 1.18rem !important; }
        #nc-root h2 { font-size: 1.04rem !important; }
      }

      @media (max-width: 900px) and (max-height: 700px) {
        :root { --space: 10px; }

        #nc-root aside,
        #nc-root [class*="SidebarContainer"] {
          min-height: 0 !important;
          max-height: none !important;
          padding-top: 2px !important;
          padding-bottom: 2px !important;
        }

        #nc-root aside li,
        #nc-root aside a,
        #nc-root [class*="SidebarContainer"] li,
        #nc-root [class*="SidebarContainer"] a,
        #nc-root [class*="NavItem"],
        #nc-root [class*="navItem"] {
          min-height: 34px !important;
          padding: 6px 10px !important;
          font-size: 12px !important;
        }

        #nc-root main,
        #nc-root [class*="CollectionMain"],
        #nc-root [class*="MainPanel"],
        #nc-root [class*="EditorToggle"] {
          padding-top: 8px !important;
          padding-bottom: 72px !important;
        }

        #recent-changes-toggle,
        #status-dot {
          padding: 7px 10px !important;
          font-size: 11px !important;
          bottom: 8px !important;
        }

        #recent-changes-panel,
        #status-panel {
          bottom: 46px !important;
          max-height: calc(100dvh - 64px) !important;
        }
      }

    </style>
  </head>
  <body>
    <script>window.CMS_MANUAL_INIT = true;</script>
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
    <script src="./autofill-plugin.js?v=20260801e"></script>

    <script>
    (function () {
      var REPO = "tt2802/fo-tj-sokol-postoupky";
      var API  = "https://api.github.com/repos/" + REPO + "/commits?per_page=10";
      var PANEL_ID = "recent-changes-panel";
      var TOGGLE_ID = "recent-changes-toggle";
      var injected = false;
      var panelOpen = false;

      function formatDate(iso) {
        var d = new Date(iso);
        return d.toLocaleDateString("cs-CZ", { day: "numeric", month: "numeric" })
          + " " + d.toLocaleTimeString("cs-CZ", { hour: "2-digit", minute: "2-digit" });
      }

      function shortenMsg(msg) {
        var first = (msg || "").split("\n")[0];
        return first.length > 55 ? first.slice(0, 52) + "…" : first;
      }

      function typeIcon(msg) {
        var m = (msg || "").toLowerCase();
        if (m.indexOf("novink") > -1 || m.indexOf("news") > -1 || m.indexOf("článek") > -1) return "📰";
        if (m.indexOf("zápas") > -1 || m.indexOf("match") > -1 || m.indexOf("score") > -1) return "⚽";
        if (m.indexOf("hráč") > -1 || m.indexOf("player") > -1 || m.indexOf("tým") > -1) return "👤";
        if (m.indexOf("galeri") > -1 || m.indexOf("foto") > -1) return "🖼️";
        if (m.indexOf("admin") > -1 || m.indexOf("cms") > -1) return "⚙️";
        return "📝";
      }

      function isCompactViewport() {
        return window.innerWidth <= 768 || window.innerHeight <= 700;
      }

      function applyFloatingLayout(toggle, panel, side) {
        var compact = isCompactViewport();
        var edge = compact ? 10 : 20;
        var bottom = compact ? 8 : 20;
        var panelBottom = compact ? 54 : 60;
        var panelWidth = compact ? "calc(100vw - 20px)" : "320px";
        var panelMaxHeight = compact ? "min(70dvh, 520px)" : "420px";

        if (toggle) {
          toggle.style.bottom = bottom + "px";
          toggle.style.fontSize = compact ? "11px" : "13px";
          toggle.style.padding = compact ? "7px 10px" : "8px 16px";
          toggle.style.left = compact ? "auto" : (side === "left" ? edge + "px" : "auto");
          toggle.style.right = compact ? (side === "right" ? edge + "px" : "10px") : (side === "right" ? edge + "px" : "auto");
        }

        if (panel) {
          panel.style.bottom = panelBottom + "px";
          panel.style.width = panelWidth;
          panel.style.maxHeight = panelMaxHeight;
          panel.style.left = compact ? "10px" : (side === "left" ? edge + "px" : "auto");
          panel.style.right = compact ? "10px" : (side === "right" ? edge + "px" : "auto");
        }
      }

      function injectPanel() {
        if (injected) return;
        injected = true;

        // Toggle button (fixed, bottom-right)
        var toggle = document.createElement("button");
        toggle.id = TOGGLE_ID;
        toggle.type = "button";
        toggle.textContent = "📋 Změny";
        toggle.style.cssText = "position:fixed;z-index:9999;padding:8px 16px;font-size:13px;font-weight:600;border:none;border-radius:20px;background:#6d28d9;color:#fff;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.2);transition:transform .15s;";
        toggle.onmouseenter = function () { toggle.style.transform = "scale(1.05)"; };
        toggle.onmouseleave = function () { toggle.style.transform = "scale(1)"; };
        toggle.onclick = function () {
          var p = document.getElementById(PANEL_ID);
          var statusPanel = document.getElementById("status-panel");
          if (p) {
            panelOpen = !panelOpen;
            p.style.display = panelOpen ? "block" : "none";
            if (panelOpen && statusPanel) {
              statusPanel.style.display = "none";
            }
          }
        };
        document.body.appendChild(toggle);

        // Side panel (fixed, bottom-right, above button)
        var panel = document.createElement("div");
        panel.id = PANEL_ID;
        panel.style.cssText = "display:none;position:fixed;z-index:9998;overflow-y:auto;padding:14px 16px;background:#fff;border:1px solid #e0e0e0;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);font-family:system-ui,-apple-system,sans-serif;";
        panel.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;"><span style="font-weight:700;font-size:14px;color:#333;">Poslední změny</span><button id="rc-close" type="button" style="border:none;background:none;cursor:pointer;font-size:18px;color:#999;padding:0 2px;">×</button></div><div id="recent-changes-list" style="color:#888;font-size:13px;">Načítám…</div>';
        document.body.appendChild(panel);
        applyFloatingLayout(toggle, panel, "right");

        document.getElementById("rc-close").onclick = function () {
          panelOpen = false;
          panel.style.display = "none";
        };

        window.addEventListener("resize", function () {
          applyFloatingLayout(toggle, panel, "right");
        });

        fetch(API)
          .then(function (r) { return r.json(); })
          .then(function (commits) {
            if (!Array.isArray(commits)) {
              document.getElementById("recent-changes-list").textContent = "Nepodařilo se načíst.";
              return;
            }
            var html = '<div style="display:flex;flex-direction:column;gap:6px;">';
            commits.forEach(function (c) {
              var msg = c.commit && c.commit.message || "";
              var date = c.commit && c.commit.author && c.commit.author.date || "";
              var sha = (c.sha || "").slice(0, 7);
              var url = c.html_url || "#";
              html += '<div style="padding:6px 8px;background:#fafafa;border-radius:5px;border:1px solid #f0f0f0;">'
                + '<div style="display:flex;align-items:center;gap:6px;">'
                + '<span style="font-size:14px;flex-shrink:0;">' + typeIcon(msg) + '</span>'
                + '<span style="font-size:12px;color:#222;line-height:1.3;overflow:hidden;text-overflow:ellipsis;">' + shortenMsg(msg).replace(/</g,"&lt;") + '</span>'
                + '</div>'
                + '<div style="font-size:11px;color:#999;margin-top:2px;padding-left:22px;">'
                + formatDate(date)
                + ' · <a href="' + url + '" target="_blank" rel="noopener" style="color:#6d28d9;text-decoration:none;">' + sha + '</a>'
                + '</div></div>';
            });
            html += '</div>';
            document.getElementById("recent-changes-list").innerHTML = html;
          })
          .catch(function () {
            document.getElementById("recent-changes-list").textContent = "Nepodařilo se načíst.";
          });
      }

      // Wait for CMS to render, then inject
      var attempts = 0;
      var timer = setInterval(function () {
        var body = document.querySelector("main") || document.querySelector("[class*='Main']");
        if (body || ++attempts > 40) { clearInterval(timer); injectPanel(); }
      }, 500);
    })();

    /* ── Status Monitor: deploy & site health check ── */
    (function () {
      var REPO = "tt2802/fo-tj-sokol-postoupky";
      var SITE = "https://tt2802.github.io/fo-tj-sokol-postoupky/";
      var GH_API = "https://api.github.com/repos/" + REPO;
      var STATUS_ID = "status-panel";
      var STATUS_DOT = "status-dot";
      var injected = false;
      var panelOpen = false;

      function isCompactViewport() {
        return window.innerWidth <= 768 || window.innerHeight <= 700;
      }

      function applyFloatingLayout(toggle, panel, side) {
        var compact = isCompactViewport();
        var edge = compact ? 10 : 20;
        var bottom = compact ? 8 : 20;
        var panelBottom = compact ? 54 : 60;
        var panelWidth = compact ? "calc(100vw - 20px)" : "320px";
        var panelMaxHeight = compact ? "min(70dvh, 520px)" : "420px";

        if (toggle) {
          toggle.style.bottom = bottom + "px";
          toggle.style.fontSize = compact ? "11px" : "13px";
          toggle.style.padding = compact ? "7px 10px" : "8px 16px";
          toggle.style.left = compact ? "auto" : (side === "left" ? edge + "px" : "auto");
          toggle.style.right = compact ? (side === "right" ? edge + "px" : "10px") : (side === "right" ? edge + "px" : "auto");
        }

        if (panel) {
          panel.style.bottom = panelBottom + "px";
          panel.style.width = panelWidth;
          panel.style.maxHeight = panelMaxHeight;
          panel.style.left = compact ? "10px" : (side === "left" ? edge + "px" : "auto");
          panel.style.right = compact ? "10px" : (side === "right" ? edge + "px" : "auto");
        }
      }

      function timeAgo(iso) {
        var diff = (Date.now() - new Date(iso).getTime()) / 1000;
        if (diff < 60) return "právě teď";
        if (diff < 3600) return Math.floor(diff / 60) + " min";
        if (diff < 86400) return Math.floor(diff / 3600) + " hod";
        return Math.floor(diff / 86400) + " dní";
      }

      function fmtDate(iso) {
        var d = new Date(iso);
        return d.toLocaleDateString("cs-CZ") + " " + d.toLocaleTimeString("cs-CZ", { hour: "2-digit", minute: "2-digit" });
      }

      function row(label, val, color) {
        return '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #f0f0f0;">'
          + '<span style="font-size:12px;color:#666;">' + label + '</span>'
          + '<span style="font-size:12px;font-weight:600;color:' + (color || "#222") + ';">' + val + '</span></div>';
      }

      function statusBadge(text, bg, fg) {
        return '<span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;background:' + bg + ';color:' + fg + ';">' + text + '</span>';
      }

      function inject() {
        if (injected) return;
        injected = true;

        // Dot indicator button (fixed, bottom-left)
        var dot = document.createElement("button");
        dot.id = STATUS_DOT;
        dot.type = "button";
        dot.innerHTML = "● Stav";
        dot.style.cssText = "position:fixed;z-index:9999;padding:8px 16px;font-size:13px;font-weight:600;border:none;border-radius:20px;background:#374151;color:#fbbf24;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.2);transition:transform .15s;";
        dot.onmouseenter = function () { dot.style.transform = "scale(1.05)"; };
        dot.onmouseleave = function () { dot.style.transform = "scale(1)"; };
        dot.onclick = function () {
          var p = document.getElementById(STATUS_ID);
          var recentChangesPanel = document.getElementById("recent-changes-panel");
          if (p) {
            panelOpen = !panelOpen;
            p.style.display = panelOpen ? "block" : "none";
            if (panelOpen && recentChangesPanel) {
              recentChangesPanel.style.display = "none";
            }
          }
        };
        document.body.appendChild(dot);

        // Panel
        var panel = document.createElement("div");
        panel.id = STATUS_ID;
        panel.style.cssText = "display:none;position:fixed;z-index:9998;padding:16px;background:#fff;border:1px solid #e0e0e0;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);font-family:system-ui,-apple-system,sans-serif;overflow-y:auto;";
        panel.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">'
          + '<span style="font-weight:700;font-size:14px;color:#333;">Stav webu</span>'
          + '<button id="st-close" type="button" style="border:none;background:none;cursor:pointer;font-size:18px;color:#999;padding:0 2px;">×</button></div>'
          + '<div id="status-content" style="font-size:13px;color:#888;">Kontroluji…</div>';
        document.body.appendChild(panel);
        applyFloatingLayout(dot, panel, "left");

        document.getElementById("st-close").onclick = function () {
          panelOpen = false;
          panel.style.display = "none";
        };

        window.addEventListener("resize", function () {
          applyFloatingLayout(dot, panel, "left");
        });

        // Run checks
        runChecks();
      }

      function runChecks() {
        var results = { commit: null, deploy: null, siteOk: null };

        // 1. Latest commit
        var p1 = fetch(GH_API + "/commits?per_page=1")
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (Array.isArray(data) && data[0]) {
              results.commit = {
                sha: data[0].sha,
                date: data[0].commit.author.date,
                msg: (data[0].commit.message || "").split("\n")[0]
              };
            }
          }).catch(function () {});

        // 2. Latest GitHub Pages deployment (via deployments API)
        var p2 = fetch(GH_API + "/pages/builds/latest")
          .then(function (r) {
            if (!r.ok) throw new Error(String(r.status || "pages-api-error"));
            return r.json();
          })
          .then(function (data) {
            if (data && data.status) {
              results.deploy = {
                status: data.status,
                created: data.created_at,
                updated: data.updated_at,
                commitSha: data.commit ? data.commit.substring(0, 7) : ""
              };
            }
          }).catch(function () {
            // Try actions workflow runs as fallback
            return fetch(GH_API + "/actions/runs?per_page=1&status=completed")
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (data && data.workflow_runs && data.workflow_runs[0]) {
                  var run = data.workflow_runs[0];
                  results.deploy = {
                    status: run.conclusion === "success" ? "built" : run.conclusion,
                    created: run.created_at,
                    updated: run.updated_at,
                    commitSha: (run.head_sha || "").substring(0, 7)
                  };
                }
              }).catch(function () {});
          });

        // 3. Site ping
        var p3 = fetch(SITE, { method: "HEAD", cache: "no-store", mode: "no-cors" })
          .then(function () { results.siteOk = true; })
          .catch(function () { results.siteOk = false; });

        Promise.all([p1, p2, p3]).then(function () {
          renderStatus(results);
        });
      }

      function renderStatus(r) {
        var html = '';

        // Overall status
        var allGood = r.siteOk !== false;
        var deployOk = r.deploy && (r.deploy.status === "built" || r.deploy.status === "success");
        var synced = true;

        if (r.commit && r.deploy && r.deploy.commitSha) {
          synced = r.commit.sha.substring(0, 7) === r.deploy.commitSha;
        }

        var overallOk = allGood && deployOk !== false;

        // Status header
        if (overallOk && synced) {
          html += '<div style="text-align:center;padding:8px 0 12px;">'
            + '<div style="font-size:28px;">✅</div>'
            + '<div style="font-size:13px;font-weight:600;color:#16a34a;margin-top:4px;">Vše v pořádku</div></div>';
        } else if (!synced) {
          html += '<div style="text-align:center;padding:8px 0 12px;">'
            + '<div style="font-size:28px;">🔄</div>'
            + '<div style="font-size:13px;font-weight:600;color:#d97706;margin-top:4px;">Probíhá nasazení…</div></div>';
        } else {
          html += '<div style="text-align:center;padding:8px 0 12px;">'
            + '<div style="font-size:28px;">⚠️</div>'
            + '<div style="font-size:13px;font-weight:600;color:#dc2626;margin-top:4px;">Problém s nasazením</div></div>';
        }

        // Web status
        if (r.siteOk === true) {
          html += row("Web", statusBadge("Online", "#dcfce7", "#16a34a"));
        } else if (r.siteOk === false) {
          html += row("Web", statusBadge("Nedostupný", "#fecaca", "#dc2626"));
        } else {
          html += row("Web", statusBadge("Neznámý", "#f3f4f6", "#6b7280"));
        }

        // Deploy status
        if (r.deploy) {
          var dLabel = r.deploy.status === "built" || r.deploy.status === "success" ? "Nasazeno" : r.deploy.status === "building" || r.deploy.status === "queued" ? "Probíhá" : r.deploy.status;
          var dBg = dLabel === "Nasazeno" ? "#dcfce7" : dLabel === "Probíhá" ? "#fef3c7" : "#fecaca";
          var dFg = dLabel === "Nasazeno" ? "#16a34a" : dLabel === "Probíhá" ? "#d97706" : "#dc2626";
          html += row("GitHub Pages", statusBadge(dLabel, dBg, dFg));
          html += row("Naposledy nasazeno", timeAgo(r.deploy.updated || r.deploy.created));
        } else {
          html += row("GitHub Pages", statusBadge("Neznámý", "#f3f4f6", "#6b7280"));
        }

        // Sync status
        if (r.commit && r.deploy && r.deploy.commitSha) {
          if (synced) {
            html += row("Synchronizace", statusBadge("Aktuální", "#dcfce7", "#16a34a"));
          } else {
            html += row("Synchronizace", statusBadge("Čeká na deploy", "#fef3c7", "#d97706"));
          }
        }

        // Latest commit
        if (r.commit) {
          html += '<div style="margin-top:10px;padding:8px 10px;background:#f8fafc;border-radius:6px;border:1px solid #e2e8f0;">'
            + '<div style="font-size:11px;color:#94a3b8;margin-bottom:4px;">Poslední commit</div>'
            + '<div style="font-size:12px;color:#334155;line-height:1.4;">' + r.commit.msg.replace(/</g, "&lt;").substring(0, 60) + '</div>'
            + '<div style="font-size:11px;color:#94a3b8;margin-top:2px;">' + fmtDate(r.commit.date) + ' · ' + r.commit.sha.substring(0, 7) + '</div></div>';
        }

        // Refresh button
        html += '<div style="text-align:center;margin-top:12px;">'
          + '<button id="st-refresh" type="button" style="padding:6px 16px;font-size:12px;border:1px solid #e0e0e0;border-radius:6px;background:#fff;color:#333;cursor:pointer;font-weight:500;">🔄 Obnovit</button></div>';

        var el = document.getElementById("status-content");
        if (el) el.innerHTML = html;

        // Bind refresh
        var btn = document.getElementById("st-refresh");
        if (btn) btn.onclick = function () {
          el.innerHTML = '<div style="text-align:center;color:#888;padding:10px;">Kontroluji…</div>';
          runChecks();
        };

        // Update dot color
        var dot = document.getElementById(STATUS_DOT);
        if (dot) {
          if (overallOk && synced) {
            dot.style.color = "#22c55e";
            dot.style.background = "#1e3a2f";
          } else if (!synced) {
            dot.style.color = "#fbbf24";
            dot.style.background = "#374151";
          } else {
            dot.style.color = "#ef4444";
            dot.style.background = "#3b1520";
          }
        }
      }

      // Inject after CMS loads
      var att = 0;
      var tm = setInterval(function () {
        var body = document.querySelector("main") || document.querySelector("[class*='Main']");
        if (body || ++att > 40) { clearInterval(tm); inject(); }
      }, 600);
    })();
    </script>
  </body>
</html>
