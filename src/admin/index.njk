<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Administrace | TJ Sokol Postoupky</title>
    <style>
      /* ── Mobile-friendly overrides for Decap CMS ── */

      /* Sidebar: stack above content on small screens */
      @media (max-width: 768px) {
        /* Make the main app wrapper column layout */
        #nc-root > div > div,
        [class*="AppMainContainer"] {
          flex-direction: column !important;
        }

        /* Sidebar: full width, horizontal scroll */
        nav, aside,
        [class*="Sidebar"],
        [class*="CollectionPane"] {
          width: 100% !important;
          min-width: 0 !important;
          max-width: 100% !important;
          border-right: none !important;
          border-bottom: 1px solid #e0e0e0;
          max-height: 180px;
          overflow-y: auto;
        }

        /* Collection list items: wrap text */
        nav a, aside a {
          font-size: 14px !important;
          padding: 8px 12px !important;
          white-space: nowrap;
        }

        /* Main content: full width */
        main, [class*="MainContent"] {
          width: 100% !important;
          min-width: 0 !important;
          padding: 12px !important;
        }

        /* Header: compact on mobile */
        header {
          flex-wrap: wrap;
          padding: 8px 12px !important;
        }
        header a, header span {
          font-size: 13px !important;
        }

        /* List items in collections */
        [class*="ListCard"],
        [class*="ObjectWidgetTopBar"] {
          padding: 10px 12px !important;
        }

        /* Form fields: full width inputs */
        input, select, textarea {
          max-width: 100% !important;
          box-sizing: border-box !important;
        }

        /* Editor toolbar: wrap */
        [class*="Toolbar"],
        [class*="EditorToggle"] {
          flex-wrap: wrap !important;
          gap: 4px;
        }

        /* Markdown editor: reasonable height */
        [class*="RawEditor"],
        [class*="VisualEditor"],
        .CodeMirror {
          min-height: 200px !important;
          font-size: 14px !important;
        }

        /* Buttons: larger touch targets */
        button {
          min-height: 36px;
        }

        /* Top bar actions: wrap "Přidat" etc. */
        [class*="TopBarButton"],
        [class*="ToolbarButton"] {
          padding: 8px 12px !important;
          font-size: 13px !important;
        }
      }

      /* Extra small screens (phones) */
      @media (max-width: 480px) {
        nav, aside,
        [class*="Sidebar"],
        [class*="CollectionPane"] {
          max-height: 140px;
        }

        header {
          padding: 6px 8px !important;
        }

        main, [class*="MainContent"] {
          padding: 8px !important;
        }
      }
    </style>
  </head>
  <body>
    <script>window.CMS_MANUAL_INIT = true;</script>
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
    <script src="./autofill-plugin.js?v=20260406e"></script>
    <script>
    (function () {
      var REPO = "tt2802/fo-tj-sokol-postoupky";
      var API  = "https://api.github.com/repos/" + REPO + "/commits?per_page=10";
      var PANEL_ID = "recent-changes-panel";
      var TOGGLE_ID = "recent-changes-toggle";
      var injected = false;
      var panelOpen = false;

      function formatDate(iso) {
        var d = new Date(iso);
        return d.toLocaleDateString("cs-CZ", { day: "numeric", month: "numeric" })
          + " " + d.toLocaleTimeString("cs-CZ", { hour: "2-digit", minute: "2-digit" });
      }

      function shortenMsg(msg) {
        var first = (msg || "").split("\n")[0];
        return first.length > 55 ? first.slice(0, 52) + "…" : first;
      }

      function typeIcon(msg) {
        var m = (msg || "").toLowerCase();
        if (m.indexOf("novink") > -1 || m.indexOf("news") > -1 || m.indexOf("článek") > -1) return "📰";
        if (m.indexOf("zápas") > -1 || m.indexOf("match") > -1 || m.indexOf("score") > -1) return "⚽";
        if (m.indexOf("hráč") > -1 || m.indexOf("player") > -1 || m.indexOf("tým") > -1) return "👤";
        if (m.indexOf("galeri") > -1 || m.indexOf("foto") > -1) return "🖼️";
        if (m.indexOf("admin") > -1 || m.indexOf("cms") > -1) return "⚙️";
        return "📝";
      }

      function injectPanel() {
        if (injected) return;
        injected = true;
        var isMobile = window.innerWidth <= 768;

        // Toggle button (fixed, bottom-right)
        var toggle = document.createElement("button");
        toggle.id = TOGGLE_ID;
        toggle.type = "button";
        toggle.textContent = "📋 Změny";
        toggle.style.cssText = "position:fixed;bottom:" + (isMobile ? "12px" : "20px") + ";right:" + (isMobile ? "12px" : "20px") + ";z-index:9999;padding:8px 16px;font-size:13px;font-weight:600;border:none;border-radius:20px;background:#6d28d9;color:#fff;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.2);transition:transform .15s;";
        toggle.onmouseenter = function () { toggle.style.transform = "scale(1.05)"; };
        toggle.onmouseleave = function () { toggle.style.transform = "scale(1)"; };
        toggle.onclick = function () {
          var p = document.getElementById(PANEL_ID);
          if (p) {
            panelOpen = !panelOpen;
            p.style.display = panelOpen ? "block" : "none";
          }
        };
        document.body.appendChild(toggle);

        // Side panel (fixed, bottom-right, above button)
        var panel = document.createElement("div");
        panel.id = PANEL_ID;
        panel.style.cssText = "display:none;position:fixed;bottom:60px;right:" + (isMobile ? "10px" : "20px") + ";z-index:9998;width:" + (isMobile ? "calc(100vw - 20px)" : "320px") + ";max-height:" + (isMobile ? "60vh" : "420px") + ";overflow-y:auto;padding:14px 16px;background:#fff;border:1px solid #e0e0e0;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);font-family:system-ui,-apple-system,sans-serif;";
        panel.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;"><span style="font-weight:700;font-size:14px;color:#333;">Poslední změny</span><button id="rc-close" type="button" style="border:none;background:none;cursor:pointer;font-size:18px;color:#999;padding:0 2px;">×</button></div><div id="recent-changes-list" style="color:#888;font-size:13px;">Načítám…</div>';
        document.body.appendChild(panel);

        document.getElementById("rc-close").onclick = function () {
          panelOpen = false;
          panel.style.display = "none";
        };

        fetch(API)
          .then(function (r) { return r.json(); })
          .then(function (commits) {
            if (!Array.isArray(commits)) {
              document.getElementById("recent-changes-list").textContent = "Nepodařilo se načíst.";
              return;
            }
            var html = '<div style="display:flex;flex-direction:column;gap:6px;">';
            commits.forEach(function (c) {
              var msg = c.commit && c.commit.message || "";
              var date = c.commit && c.commit.author && c.commit.author.date || "";
              var sha = (c.sha || "").slice(0, 7);
              var url = c.html_url || "#";
              html += '<div style="padding:6px 8px;background:#fafafa;border-radius:5px;border:1px solid #f0f0f0;">'
                + '<div style="display:flex;align-items:center;gap:6px;">'
                + '<span style="font-size:14px;flex-shrink:0;">' + typeIcon(msg) + '</span>'
                + '<span style="font-size:12px;color:#222;line-height:1.3;overflow:hidden;text-overflow:ellipsis;">' + shortenMsg(msg).replace(/</g,"&lt;") + '</span>'
                + '</div>'
                + '<div style="font-size:11px;color:#999;margin-top:2px;padding-left:22px;">'
                + formatDate(date)
                + ' · <a href="' + url + '" target="_blank" rel="noopener" style="color:#6d28d9;text-decoration:none;">' + sha + '</a>'
                + '</div></div>';
            });
            html += '</div>';
            document.getElementById("recent-changes-list").innerHTML = html;
          })
          .catch(function () {
            document.getElementById("recent-changes-list").textContent = "Nepodařilo se načíst.";
          });
      }

      // Wait for CMS to render, then inject
      var attempts = 0;
      var timer = setInterval(function () {
        var body = document.querySelector("main") || document.querySelector("[class*='Main']");
        if (body || ++attempts > 40) { clearInterval(timer); injectPanel(); }
      }, 500);
    })();
    </script>
  </body>
</html>
