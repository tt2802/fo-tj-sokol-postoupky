<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Administrace | TJ Sokol Postoupky</title>
  </head>
  <body>
    <script>window.CMS_MANUAL_INIT = true;</script>
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
    <script src="./autofill-plugin.js?v=20260406d"></script>
    <script>
    (function () {
      var REPO = "tt2802/fo-tj-sokol-postoupky";
      var API  = "https://api.github.com/repos/" + REPO + "/commits?per_page=15";
      var PANEL_ID = "recent-changes-panel";
      var injected = false;

      function formatDate(iso) {
        var d = new Date(iso);
        return d.toLocaleDateString("cs-CZ", { day: "numeric", month: "numeric", year: "numeric" })
          + " " + d.toLocaleTimeString("cs-CZ", { hour: "2-digit", minute: "2-digit" });
      }

      function shortenMsg(msg) {
        var first = (msg || "").split("\n")[0];
        return first.length > 80 ? first.slice(0, 77) + "…" : first;
      }

      function typeIcon(msg) {
        var m = (msg || "").toLowerCase();
        if (m.indexOf("novink") > -1 || m.indexOf("news") > -1 || m.indexOf("článek") > -1) return "📰";
        if (m.indexOf("zápas") > -1 || m.indexOf("match") > -1 || m.indexOf("score") > -1) return "⚽";
        if (m.indexOf("hráč") > -1 || m.indexOf("player") > -1 || m.indexOf("tým") > -1) return "👤";
        if (m.indexOf("galeri") > -1 || m.indexOf("foto") > -1) return "🖼️";
        if (m.indexOf("admin") > -1 || m.indexOf("cms") > -1) return "⚙️";
        return "📝";
      }

      function injectPanel() {
        if (injected || document.getElementById(PANEL_ID)) return;
        // Only inject on the main collection list (not when editing)
        var hash = window.location.hash || "";
        if (hash.indexOf("/entries/") > -1 || hash.indexOf("/new") > -1) return;

        // Find the main content area
        var main = document.querySelector("main") || document.querySelector("[class*='Main']");
        if (!main) return;

        // Check if we're on a collections listing page
        var wrapper = main.querySelector("div");
        if (!wrapper) return;

        injected = true;

        var panel = document.createElement("div");
        panel.id = PANEL_ID;
        panel.style.cssText = "margin:20px auto;max-width:800px;padding:20px 24px;background:#fff;border:1px solid #e0e0e0;border-radius:10px;box-shadow:0 1px 4px rgba(0,0,0,.06);";
        panel.innerHTML = '<h3 style="margin:0 0 14px;font-size:16px;color:#333;">Poslední změny</h3><div id="recent-changes-list" style="color:#888;font-size:14px;">Načítám…</div>';

        // Insert after main content
        main.appendChild(panel);

        fetch(API)
          .then(function (r) { return r.json(); })
          .then(function (commits) {
            if (!Array.isArray(commits)) {
              document.getElementById("recent-changes-list").textContent = "Nepodařilo se načíst.";
              return;
            }
            var html = '<div style="display:flex;flex-direction:column;gap:8px;">';
            commits.forEach(function (c) {
              var msg = c.commit && c.commit.message || "";
              var date = c.commit && c.commit.author && c.commit.author.date || "";
              var author = c.commit && c.commit.author && c.commit.author.name || "";
              var sha = (c.sha || "").slice(0, 7);
              var url = c.html_url || "#";
              html += '<div style="display:flex;align-items:flex-start;gap:10px;padding:8px 10px;background:#fafafa;border-radius:6px;border:1px solid #f0f0f0;">'
                + '<span style="font-size:18px;flex-shrink:0;margin-top:1px;">' + typeIcon(msg) + '</span>'
                + '<div style="flex:1;min-width:0;">'
                + '<div style="font-size:14px;color:#222;line-height:1.4;">' + shortenMsg(msg).replace(/</g,"&lt;") + '</div>'
                + '<div style="font-size:12px;color:#888;margin-top:2px;">'
                + formatDate(date) + ' · ' + author.replace(/</g,"&lt;")
                + ' · <a href="' + url + '" target="_blank" rel="noopener" style="color:#6d28d9;text-decoration:none;">' + sha + '</a>'
                + '</div></div></div>';
            });
            html += '</div>';
            document.getElementById("recent-changes-list").innerHTML = html;
          })
          .catch(function () {
            document.getElementById("recent-changes-list").textContent = "Nepodařilo se načíst změny.";
          });
      }

      function tryInject() {
        // Remove panel when navigating to edit view
        var hash = window.location.hash || "";
        if (hash.indexOf("/entries/") > -1 || hash.indexOf("/new") > -1) {
          var existing = document.getElementById(PANEL_ID);
          if (existing) { existing.remove(); injected = false; }
          return;
        }
        injectPanel();
      }

      // Observe hash changes and DOM mutations
      window.addEventListener("hashchange", function () { injected = false; setTimeout(tryInject, 500); });

      var obs = new MutationObserver(function () { tryInject(); });
      var attempts = 0;
      var timer = setInterval(function () {
        var body = document.querySelector("main") || document.querySelector("[class*='Main']");
        if (body) { obs.observe(body, { childList: true, subtree: true }); clearInterval(timer); tryInject(); }
        if (++attempts > 60) clearInterval(timer);
      }, 500);
    })();
    </script>
  </body>
</html>
