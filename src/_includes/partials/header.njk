<header class="site-header">
  <div class="header-inner">
    <a href="{{ '/' | url }}" class="logo">
      <img src="{{ '/assets/img/logo.png' | url }}" alt="TJ Sokol Postoupky">

      <span class="logo__text">TJ Sokol Postoupky</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mainNav">
      <span class="sr-only">Otevřít menu</span>
      ☰
    </button>

    <nav id="mainNav" class="main-nav" aria-label="Hlavní navigace">
      <a href="{{ '/' | url }}">Domů</a>
      <a href="{{ '/novinky/' | url }}">Novinky</a>

      <div class="dropdown">
        <button class="dropdown-toggle" aria-expanded="false">Muži ▾</button>
        <div class="dropdown-menu">
          <a href="{{ '/muzi/' | url }}">Přehled</a>
          <a href="{{ '/muzi/zapasy/' | url }}">Zápasy</a>
          <a href="{{ '/muzi/tym/' | url }}">Tým</a>
        </div>
      </div>

      <div class="dropdown">
        <button class="dropdown-toggle" aria-expanded="false">Mládež ▾</button>
        <div class="dropdown-menu">
          {% set youthCats = categories.items | default([]) %}

          {% if youthCats | length == 0 %}
            <a href="{{ '/mladez/' | url }}">Přehled kategorií</a>
          {% else %}
            {% for cat in youthCats %}
              <a href="{{ ('/mladez/' ~ cat.id ~ '/') | url }}">{{ cat.name }}</a>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <a href="{{ '/galerie/' | url }}">Galerie</a>
      <a href="{{ '/diskuze/' | url }}">Diskuze</a>
      <a href="{{ '/partneri/' | url }}">Partneři</a>
      <a href="{{ '/kontakty/' | url }}">Kontakty</a>
      <a href="{{ '/nabor/' | url }}">Nábor</a>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Přepnout tmavý režim" title="Tmavý / světlý režim">
        <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
    </nav>
  </div>
</header>
