---
layout: layouts/base.njk
---

<section class="section news-detail">
  <div class="container">
    <article class="prose">
      <p class="muted">
        {{ page.date | czDate }}
      </p>

      <h1>{{ title }}</h1>

      {{ content | safe }}
    </article>

    {# ── Komentáře ── #}
    <section class="comments-section" id="commentsSection">
      <h2 class="comments-title">Komentáře <span class="comments-count" id="commentsCount"></span></h2>

      <div id="commentAuth" class="comments-auth">
        <button id="commentLogin" class="chat-google-btn">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="" width="18" height="18">
          Přihlásit se pro komentování
        </button>
      </div>

      <form id="commentForm" class="comment-form" style="display:none;">
        <div class="comment-form__user" id="commentUser"></div>
        <textarea id="commentText" class="comment-input" rows="3" placeholder="Napište komentář…" maxlength="1000" required></textarea>
        <div class="comment-form__actions">
          <button type="submit" class="btn btn--primary btn--sm">Odeslat komentář</button>
        </div>
      </form>

      <div class="comments-list" id="commentsList"></div>
    </section>
  </div>
</section>

{# ── Firebase SDK ── #}
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>

<script>
(function() {
  var cfg = {{ firebase | dump | safe }};
  if (!cfg.apiKey || cfg.apiKey === 'FIREBASE_API_KEY') {
    document.getElementById('commentsSection').innerHTML =
      '<p class="muted">Komentáře budou dostupné brzy.</p>';
    return;
  }

  firebase.initializeApp(cfg);
  var auth = firebase.auth();
  var db = firebase.firestore();
  var postSlug = '{{ page.fileSlug }}';
  var currentUser = null;

  var authEl    = document.getElementById('commentAuth');
  var formEl    = document.getElementById('commentForm');
  var userEl    = document.getElementById('commentUser');
  var textEl    = document.getElementById('commentText');
  var listEl    = document.getElementById('commentsList');
  var countEl   = document.getElementById('commentsCount');
  var loginBtn  = document.getElementById('commentLogin');

  var provider = new firebase.auth.GoogleAuthProvider();
  provider.setCustomParameters({ prompt: 'select_account' });
  var authInProgress = false;

  function setLoginBusyState(busy) {
    var btn = document.getElementById('commentLogin');
    if (!btn) return;
    btn.disabled = !!busy;
    btn.style.opacity = busy ? '0.7' : '';
    btn.style.cursor = busy ? 'wait' : '';
  }

  function showAuthMessage(html) {
    var msgEl = document.getElementById('commentAuth');
    if (!msgEl) return;
    msgEl.innerHTML = html;
    msgEl.style.display = '';
  }

  function handleAuthError(err) {
    console.error('Auth error:', err && err.code, err && err.message);
    if (!err) {
      showAuthMessage('<p style="color:#dc2626;font-weight:600;">Neznámá chyba přihlášení.</p>');
      return;
    }

    if (err.code === 'auth/unauthorized-domain') {
      showAuthMessage('<p style="color:#dc2626;font-weight:600;">Doména není povolená ve Firebase Authentication. V konzoli Firebase přidejte doménu tohoto webu do Authorized domains.</p>');
      return;
    }

    if (err.code === 'auth/operation-not-allowed') {
      showAuthMessage('<p style="color:#dc2626;font-weight:600;">Ve Firebase není povolené přihlášení přes Google provider.</p>');
      return;
    }

    showAuthMessage('<div style="color:#dc2626;font-weight:600;">Chyba přihlášení: ' + escapeHtml(err.code) + '<br><small>' + escapeHtml(err.message) + '</small></div>');
  }

  /* ── Auth ── */
  auth.getRedirectResult().then(function(result) {
    if (result && result.user) {
      authInProgress = false;
      setLoginBusyState(false);
    }
  }).catch(function(err) {
    handleAuthError(err);
  });

  loginBtn.addEventListener('click', function() {
    if (authInProgress) return;
    authInProgress = true;
    setLoginBusyState(true);
    showAuthMessage('<p style="color:#b45309;font-weight:600;">Přesměrovávám na Google přihlášení…</p>');

    auth.signInWithRedirect(provider).catch(function(err) {
      handleAuthError(err);
    }).finally(function() {
      authInProgress = false;
      setLoginBusyState(false);
    });
  });

  auth.onAuthStateChanged(function(user) {
    currentUser = user;
    if (user) {
      authEl.style.display = 'none';
      formEl.style.display = 'block';
      userEl.innerHTML =
        '<img src="' + escapeHtml(user.photoURL || '') + '" alt="" class="chat-avatar-sm">' +
        '<span>' + escapeHtml(user.displayName) + '</span>' +
        '<button type="button" id="commentLogout" class="chat-logout-btn" title="Odhlásit">✕</button>';
      document.getElementById('commentLogout').addEventListener('click', function() {
        auth.signOut();
      });
    } else {
      authEl.style.display = '';
      formEl.style.display = 'none';
    }
  });

  /* ── Submit comment ── */
  formEl.addEventListener('submit', function(e) {
    e.preventDefault();
    var text = textEl.value.trim();
    if (!text || !currentUser) return;
    textEl.value = '';
    db.collection('comments').add({
      postSlug: postSlug,
      text: text,
      userName: currentUser.displayName,
      userPhoto: currentUser.photoURL,
      userId: currentUser.uid,
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });
  });

  /* ── Listen for comments ── */
  db.collection('comments')
    .where('postSlug', '==', postSlug)
    .orderBy('createdAt', 'asc')
    .onSnapshot(function(snap) {
      listEl.innerHTML = '';
      var count = 0;
      snap.forEach(function(doc) {
        var d = doc.data();
        if (!d.createdAt) return;
        count++;
        var time = d.createdAt.toDate();
        var dd = time.getDate();
        var mo = time.getMonth() + 1;
        var yyyy = time.getFullYear();
        var hh = String(time.getHours()).padStart(2,'0');
        var mm = String(time.getMinutes()).padStart(2,'0');

        var div = document.createElement('div');
        div.className = 'comment';
        div.innerHTML =
          '<img src="' + (d.userPhoto || '') + '" alt="" class="comment__avatar">' +
          '<div class="comment__body">' +
            '<div class="comment__meta">' +
              '<strong>' + escapeHtml(d.userName) + '</strong>' +
              '<span class="comment__time">' + dd + '.' + mo + '.' + yyyy + ' ' + hh + ':' + mm + '</span>' +
            '</div>' +
            '<div class="comment__text">' + escapeHtml(d.text) + '</div>' +
          '</div>';
        listEl.appendChild(div);
      });
      countEl.textContent = count > 0 ? '(' + count + ')' : '';
    }, function(err) {
      console.error('Firestore comments error:', err);
      if (err.code === 'failed-precondition') {
        // Index needed – fall back to simple query
        db.collection('comments')
          .where('postSlug', '==', postSlug)
          .get().then(function(snap) {
            var docs = [];
            snap.forEach(function(doc) { docs.push(doc); });
            docs.sort(function(a,b) {
              var ta = a.data().createdAt, tb = b.data().createdAt;
              if (!ta || !tb) return 0;
              return ta.toMillis() - tb.toMillis();
            });
            listEl.innerHTML = '';
            var count = 0;
            docs.forEach(function(doc) {
              var d = doc.data();
              if (!d.createdAt) return;
              count++;
              var time = d.createdAt.toDate();
              var dd = time.getDate(), mo = time.getMonth()+1, yyyy = time.getFullYear();
              var hh = String(time.getHours()).padStart(2,'0');
              var mm = String(time.getMinutes()).padStart(2,'0');
              var div = document.createElement('div');
              div.className = 'comment';
              div.innerHTML =
                '<img src="' + (d.userPhoto || '') + '" alt="" class="comment__avatar">' +
                '<div class="comment__body"><div class="comment__meta"><strong>' + escapeHtml(d.userName) + '</strong>' +
                '<span class="comment__time">' + dd + '.' + mo + '.' + yyyy + ' ' + hh + ':' + mm + '</span></div>' +
                '<div class="comment__text">' + escapeHtml(d.text) + '</div></div>';
              listEl.appendChild(div);
            });
            countEl.textContent = count > 0 ? '(' + count + ')' : '';
          });
      }
    });

  function escapeHtml(str) {
    var d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }
})();
</script>
