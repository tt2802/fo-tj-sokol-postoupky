<section class="section section--no-bg">
  <div class="container">

    {# ── Chat container ── #}
    <div class="chat-container">
      <div class="chat-header">
        <div class="chat-header__left">
          <span class="chat-header__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <h1 class="chat-header__title">Chat – Sokol Postoupky</h1>
        </div>
        <div class="chat-header__right" id="chatUser">
          <button id="chatLogin" class="chat-google-btn">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="" width="18" height="18">
            Přihlásit se přes Google
          </button>
        </div>
      </div>

      <div class="chat-messages" id="chatMessages">
        <div class="chat-welcome" id="chatWelcome">
          <div style="font-size: 3rem; color: var(--text-muted);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 6V3"/><path d="M17 6V3"/></svg>
          </div>
          <h2>Vítejte v chatu</h2>
          <p>Přihlaste se přes Google a můžete začít psát s ostatními fanoušky a hráči.</p>
        </div>
      </div>

      <div class="chat-input-area" id="chatInputArea" style="display:none;">
        <input type="text" id="chatInput" class="chat-input" placeholder="Napište zprávu…" maxlength="500" autocomplete="off">
        <button id="chatSend" class="chat-send-btn" title="Odeslat">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2L15 22L11 13L2 9L22 2Z"/></svg>
        </button>
      </div>
    </div>

    {# ── Facebook odkaz ── #}
    <div style="text-align:center; margin-top:2rem;">
      <p class="muted">Delší příspěvky a fotky sdílejte na
        <a href="https://www.facebook.com/groups/509171789420773" target="_blank" rel="noopener noreferrer" style="color:#1877f2;font-weight:600;">Facebook skupině</a>.
      </p>
    </div>

  </div>
</section>

{# ── Firebase SDK ── #}
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>

<script>
(function() {
  var cfg = {{ firebase | dump | safe }};
  if (!cfg.apiKey || cfg.apiKey === 'FIREBASE_API_KEY') {
    document.getElementById('chatWelcome').innerHTML =
      '<p style="color:#dc2626;font-weight:600;">Firebase není nakonfigurován. Kontaktujte správce webu.</p>';
    return;
  }

  if (!firebase.apps || !firebase.apps.length) {
    firebase.initializeApp(cfg);
  }
  var auth = firebase.auth();
  var db = firebase.firestore();
  var currentUser = null;
  var unsubscribeMessages = null;

  var messagesEl = document.getElementById('chatMessages');
  var welcomeEl  = document.getElementById('chatWelcome');
  var inputArea  = document.getElementById('chatInputArea');
  var inputEl    = document.getElementById('chatInput');
  var sendBtn    = document.getElementById('chatSend');
  var loginBtn   = document.getElementById('chatLogin');
  var userEl     = document.getElementById('chatUser');

  var provider = new firebase.auth.GoogleAuthProvider();
  provider.setCustomParameters({ prompt: 'select_account' });

  function escapeHtml(str) {
    var d = document.createElement('div');
    d.textContent = str || '';
    return d.innerHTML;
  }

  function setWelcomeHtml(html) {
    var msgEl = document.getElementById('chatWelcome');
    if (!msgEl) return;
    msgEl.innerHTML = html;
    msgEl.style.display = '';
  }

  function handleAuthError(err) {
    console.error('Auth error:', err && err.code, err && err.message);
    if (!err) {
      setWelcomeHtml('<p style="color:#dc2626;font-weight:600;">Neznámá chyba přihlášení.</p>');
      return;
    }
    if (err.code === 'auth/unauthorized-domain') {
      setWelcomeHtml('<p style="color:#dc2626;font-weight:600;">Doména není povolená ve Firebase Authentication. Přidejte ji do Authorized domains v konzoli Firebase.</p>');
      return;
    }
    if (err.code === 'auth/operation-not-allowed') {
      setWelcomeHtml('<p style="color:#dc2626;font-weight:600;">Ve Firebase není povolené přihlášení přes Google.</p>');
      return;
    }
    setWelcomeHtml('<div style="color:#dc2626;font-weight:600;">Chyba přihlášení: ' + escapeHtml(err.code) + '<br><small>' + escapeHtml(err.message) + '</small></div>');
  }

  function renderSignedIn(user) {
    // re-query elements in case DOM was modified
    var wa = document.getElementById('chatWelcome');
    var ia = document.getElementById('chatInputArea');
    var ue = document.getElementById('chatUser');
    var ie = document.getElementById('chatInput');
    if (wa) wa.style.display = 'none';
    if (ia) ia.style.display = 'flex';
    if (ue) {
      ue.innerHTML =
        '<img src="' + escapeHtml((user && user.photoURL) || '') + '" alt="" class="chat-avatar-sm">' +
        '<span class="chat-username">' + escapeHtml((user && user.displayName) || 'Přihlášený uživatel') + '</span>' +
        '<button type="button" id="chatLogout" class="chat-logout-btn" title="Odhlásit">✕</button>';
      var logoutBtn = document.getElementById('chatLogout');
      if (logoutBtn) logoutBtn.addEventListener('click', function() { auth.signOut(); });
    }
    if (ie) ie.focus();
  }

  function renderSignedOut() {
    var wa = document.getElementById('chatWelcome');
    var ia = document.getElementById('chatInputArea');
    var ue = document.getElementById('chatUser');
    if (wa) wa.style.display = '';
    if (ia) ia.style.display = 'none';
    if (ue) {
      ue.innerHTML =
        '<button id="chatLogin" class="chat-google-btn" type="button">' +
        '<img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="" width="18" height="18">' +
        ' Přihlásit se přes Google</button>';
      var btn = document.getElementById('chatLogin');
      if (btn) btn.addEventListener('click', doLogin);
    }
  }

  function doLogin() {
    setWelcomeHtml('<p style="color:#b45309;font-weight:600;">Přesměrovávám na Google přihlášení…</p>');
    var btn = document.getElementById('chatLogin');
    if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; }
    auth.signInWithRedirect(provider).catch(handleAuthError);
  }

  /* ── Auth state ── */
  auth.getRedirectResult().then(function(result) {
    if (result && result.user) renderSignedIn(result.user);
  }).catch(handleAuthError);

  if (loginBtn) loginBtn.addEventListener('click', doLogin);

  function detachMessagesListener() {
    if (typeof unsubscribeMessages === 'function') {
      try { unsubscribeMessages(); } catch (_) {}
      unsubscribeMessages = null;
    }
  }

  function clearRenderedMessages() {
    var msgs = messagesEl.querySelectorAll('.chat-msg');
    msgs.forEach(function(m) { m.remove(); });
  }

  function attachMessagesListener() {
    detachMessagesListener();
    unsubscribeMessages = db.collection('chat_messages')
      .orderBy('createdAt', 'asc')
      .limitToLast(150)
      .onSnapshot(function(snap) {
        var wa = document.getElementById('chatWelcome');
        if (currentUser && wa) wa.style.display = 'none';

        clearRenderedMessages();

        snap.forEach(function(doc) {
          var d = doc.data();
          if (!d.createdAt) return; // pending write
          var isOwn = currentUser && d.userId === currentUser.uid;
          var time = d.createdAt.toDate();
          var hh = String(time.getHours()).padStart(2,'0');
          var mm = String(time.getMinutes()).padStart(2,'0');
          var dd = time.getDate();
          var mo = time.getMonth() + 1;

          var div = document.createElement('div');
          div.className = 'chat-msg' + (isOwn ? ' chat-msg--own' : '');
          div.innerHTML =
            '<img src="' + escapeHtml(d.userPhoto || '') + '" alt="" class="chat-msg__avatar">' +
            '<div class="chat-msg__body">' +
              '<div class="chat-msg__meta">' +
                '<strong>' + escapeHtml(d.userName) + '</strong>' +
                '<span class="chat-msg__time">' + dd + '.' + mo + '. ' + hh + ':' + mm + '</span>' +
              '</div>' +
              '<div class="chat-msg__text">' + escapeHtml(d.text) + '</div>' +
            '</div>';
          messagesEl.appendChild(div);
        });

        messagesEl.scrollTop = messagesEl.scrollHeight;
      }, function(err) {
        console.error('Firestore onSnapshot error:', err && err.code, err);
        if (err && err.code === 'permission-denied') {
          if (currentUser) {
            setWelcomeHtml('<p style="color:#dc2626;font-weight:600;">Přihlášení proběhlo, ale chat nemá oprávnění číst zprávy (Firestore rules).</p>');
          }
          detachMessagesListener();
        }
      });
  }

  auth.onAuthStateChanged(function(user) {
    currentUser = user;
    if (user) {
      renderSignedIn(user);
      attachMessagesListener();
    } else {
      detachMessagesListener();
      clearRenderedMessages();
      renderSignedOut();
    }
  });

  /* ── Send message ── */
  function sendMessage() {
    var text = inputEl.value.trim();
    if (!text || !currentUser) return;
    inputEl.value = '';
    db.collection('chat_messages').add({
      text: text,
      userName: currentUser.displayName,
      userPhoto: currentUser.photoURL,
      userId: currentUser.uid,
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });
  }

  sendBtn.addEventListener('click', sendMessage);
  inputEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') sendMessage();
  });

})();
</script>
