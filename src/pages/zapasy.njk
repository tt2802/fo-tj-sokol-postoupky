{# file: src/pages/zapasy.njk #}
---
layout: layouts/page.njk
title: Zápasy a výsledky
permalink: /zapasy/
---

<h1>Zápasy a výsledky</h1>

<section class="section" style="padding-top: .5rem;">
  <h2>Živě teď</h2>
  {% if matchesComputed.liveMatches.length %}
    <ol class="cardsList">
      {% for m in matchesComputed.liveMatches %}
        <li class="card" style="border-left: 4px solid #ef4444;">
          <div class="card__body">
            <p class="muted">
              🔴 {{ m._dateStr | czDate }}{% if m.time %} · {{ m.time }}{% endif %}
              {% if m.competition %} · {{ m.competition }}{% endif %}
              · {{ m._teamLabel }}
            </p>
            <p class="matchLine"><strong>{{ m.home }}</strong> vs <strong>{{ m.away }}</strong></p>
            {% set liveEmbedId = 'live-all-' + m.team + '-' + m.slug %}
            <div style="display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.5rem;">
              <button type="button" class="btn btn--live" data-inline-video-toggle="{{ liveEmbedId }}" data-toggle-label="Sledovat živě">Sledovat živě</button>
              <a class="btn btn--secondary" href="{{ m.liveUrl }}" target="_blank" rel="noopener">
                {% if ('youtube.com' in m.liveUrl) or ('youtu.be' in m.liveUrl) %}Otevřít na YouTube{% else %}Otevřít odkaz{% endif %}
              </a>
            </div>
            <div id="{{ liveEmbedId }}" class="video-embed" data-video-url="{{ m.liveUrl | escape }}" hidden></div>
          </div>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="muted">Aktuálně není vypsaný žádný živý přenos.</p>
  {% endif %}
</section>

<section class="section">
  <h2>Čeká nás</h2>

  {% if matchesComputed.upcoming.length %}
    <ol class="cardsList">
      {% for m in matchesComputed.upcoming %}
        <li class="card">
          <div class="card__body">
            <p class="muted">
              {{ m._dateStr | czDate }}{% if m.time %} · {{ m.time }}{% endif %}
              {% if m.competition %} · {{ m.competition }}{% endif %}
              {% if m.round %} · {{ m.round }}{% endif %}
              · {{ m._teamLabel }}
              {% if m.season %} · Sezóna {{ m.season }}{% endif %}
            </p>

            <p class="matchLine">
              <strong>{{ m.home }}</strong>
              vs
              <strong>{{ m.away }}</strong>
            </p>

            {% if m.venue %}
              <p class="muted">Místo: {{ m.venue }}</p>
            {% endif %}

            {% if m.liveUrl %}
              {% set liveEmbedId = 'live-upcoming-' + m.team + '-' + m.slug %}
              <div style="display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.5rem;">
                <button type="button" class="btn btn--live" data-inline-video-toggle="{{ liveEmbedId }}" data-toggle-label="Sledovat živě">Sledovat živě</button>
                <a class="btn btn--secondary" href="{{ m.liveUrl }}" target="_blank" rel="noopener">
                  {% if ('youtube.com' in m.liveUrl) or ('youtu.be' in m.liveUrl) %}Otevřít na YouTube{% else %}Otevřít odkaz{% endif %}
                </a>
              </div>
              <div id="{{ liveEmbedId }}" class="video-embed" data-video-url="{{ m.liveUrl | escape }}" hidden></div>
            {% endif %}

            {% if m.team == 'muzi' %}
              <p><a href="{{ ('/muzi/zapasy/' + m.slug + '/') | url }}">Detail zápasu</a></p>
            {% elseif m.team == 'mladez' and m.category %}
              <p><a href="{{ ('/mladez/' + m.category + '/zapasy/' + m.slug + '/') | url }}">Detail zápasu</a></p>
            {% else %}
              <p class="muted">Detail zápasu není dostupný.</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="muted">Zatím nemáme vypsaný žádný další zápas.</p>
  {% endif %}
</section>

<section class="section">
  <h2>Odehráno</h2>

  {% if matchesComputed.played.length %}
    <ol class="cardsList">
      {% for m in matchesComputed.played %}
        <li class="card">
          <div class="card__body">
            <p class="muted">
              {{ m._dateStr | czDate }}{% if m.time %} · {{ m.time }}{% endif %}
              {% if m.competition %} · {{ m.competition }}{% endif %}
              {% if m.round %} · {{ m.round }}{% endif %}
              · {{ m._teamLabel }}
              {% if m.season %} · Sezóna {{ m.season }}{% endif %}
            </p>

            <p class="matchLine">
              <strong>{{ m.home }}</strong>
              {{ m.homeScore }} : {{ m.awayScore }}
              <strong>{{ m.away }}</strong>
            </p>

            {% if m.videoUrl %}
              {% set videoEmbedId = 'video-' + m.team + '-' + m.slug %}
              <div style="display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.5rem;">
                <button type="button" class="btn btn--secondary" data-inline-video-toggle="{{ videoEmbedId }}" data-toggle-label="Přehrát video">Přehrát video</button>
                <a class="btn btn--secondary" href="{{ m.videoUrl }}" target="_blank" rel="noopener">
                  {% if ('youtube.com' in m.videoUrl) or ('youtu.be' in m.videoUrl) %}Otevřít na YouTube{% else %}Otevřít video{% endif %}
                </a>
              </div>
              <div id="{{ videoEmbedId }}" class="video-embed" data-video-url="{{ m.videoUrl | escape }}" hidden></div>
            {% endif %}

            {% if m.team == 'muzi' %}
              <p><a href="{{ ('/muzi/zapasy/' + m.slug + '/') | url }}">Detail zápasu</a></p>
            {% elseif m.team == 'mladez' and m.category %}
              <p><a href="{{ ('/mladez/' + m.category + '/zapasy/' + m.slug + '/') | url }}">Detail zápasu</a></p>
            {% else %}
              <p class="muted">Detail zápasu není dostupný.</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="muted">Zatím nemáme zapsaný žádný výsledek.</p>
  {% endif %}
</section>

<script defer src="{{ '/assets/js/matches-filter.js' | url }}"></script>
