{# file: src/pages/zapasy.njk #}
---
layout: layouts/page.njk
title: Zápasy a výsledky
permalink: /zapasy/
---

<h1>Zápasy a výsledky</h1>

<section class="section">
  <h2>Čeká nás</h2>

  {% if matchesComputed.upcoming.length %}
    <ol class="cardsList">
      {% for m in matchesComputed.upcoming %}
        <li class="card">
          <div class="card__body">
            <p class="muted">
              {{ m._dateStr | czDate }}{% if m.time %} · {{ m.time }}{% endif %}
              {% if m.competition %} · {{ m.competition }}{% endif %}
              {% if m.round %} · {{ m.round }}{% endif %}
              · {{ m._teamLabel }}
              {% if m.season %} · Sezóna {{ m.season }}{% endif %}
            </p>

            <p class="matchLine">
              <strong>{{ m.home }}</strong>
              vs
              <strong>{{ m.away }}</strong>
            </p>

            {% if m.venue %}
              <p class="muted">Místo: {{ m.venue }}</p>
            {% endif %}

            {% if m.team == 'muzi' %}
              <p><a href="{{ ('/muzi/zapasy/' + m.slug + '/') | url }}">Detail zápasu</a></p>
            {% elseif m.team == 'mladez' and m.category %}
              <p><a href="{{ ('/mladez/' + m.category + '/zapasy/' + m.slug + '/') | url }}">Detail zápasu</a></p>
            {% else %}
              <p class="muted">Detail zápasu není dostupný.</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="muted">Zatím nemáme vypsaný žádný další zápas.</p>
  {% endif %}
</section>

<section class="section">
  <h2>Odehráno</h2>

  {% if matchesComputed.played.length %}
    <ol class="cardsList">
      {% for m in matchesComputed.played %}
        <li class="card">
          <div class="card__body">
            <p class="muted">
              {{ m._dateStr | czDate }}{% if m.time %} · {{ m.time }}{% endif %}
              {% if m.competition %} · {{ m.competition }}{% endif %}
              {% if m.round %} · {{ m.round }}{% endif %}
              · {{ m._teamLabel }}
              {% if m.season %} · Sezóna {{ m.season }}{% endif %}
            </p>

            <p class="matchLine">
              <strong>{{ m.home }}</strong>
              {{ m.homeScore }} : {{ m.awayScore }}
              <strong>{{ m.away }}</strong>
            </p>

            {% if m.videoUrl %}
              <p class="muted">🎥 Video je k dispozici</p>
            {% endif %}

            {% if m.team == 'muzi' %}
              <p><a href="{{ ('/muzi/zapasy/' + m.slug + '/') | url }}">Detail zápasu</a></p>
            {% elseif m.team == 'mladez' and m.category %}
              <p><a href="{{ ('/mladez/' + m.category + '/zapasy/' + m.slug + '/') | url }}">Detail zápasu</a></p>
            {% else %}
              <p class="muted">Detail zápasu není dostupný.</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="muted">Zatím nemáme zapsaný žádný výsledek.</p>
  {% endif %}
</section>
