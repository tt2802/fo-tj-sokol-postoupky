---
layout: layouts/page.njk
title: Novinky
permalink: /novinky/
---

<section class="section">
  <div class="container">
    <h1>Novinky</h1>

    {% if collections.news.length %}
      <div class="grid cards">
        {% for post in collections.news %}
          <article class="card">
            <div class="card__body">
              <p class="muted">{{ post.date | czDate }}</p>
              <h2 class="card__title">{{ post.data.title }}</h2>
              {% if post.data.excerpt %}
                <p>{{ post.data.excerpt }}</p>
              {% else %}
                <p>{{ post.templateContent | striptags | truncate(120) }}</p>
              {% endif %}
              <p><a class="btn" href="{{ post.url | url }}">Přečíst novinku</a></p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p>Zatím tu nejsou žádné novinky.</p>
    {% endif %}
  </div>
</section>
