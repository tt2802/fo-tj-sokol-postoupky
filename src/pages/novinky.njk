---
layout: layouts/page.njk
title: Novinky
---

<section class="section">
  <div class="container">
    <h1>Novinky</h1>

    {% if collections.news.length %}
      <div class="grid cards">
        {% for post in collections.news %}
          <article class="card">
            <div class="card__body">
              <h2 class="card__title">
                <a href="{{ post.url }}">{{ post.data.title }}</a>
              </h2>

              <p class="muted">
                {{ post.date | czDate }}
              </p>

              <p>
                {{ post.templateContent | striptags | truncate(120) }}
              </p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p>Zatím tu nejsou žádné novinky.</p>
    {% endif %}
  </div>
</section>
