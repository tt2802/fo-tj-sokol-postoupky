---
title: Galerie
permalink: /galerie/
layout: layouts/page.njk
---

<section class="section">
  <div class="container">
    <h1>Galerie</h1>
    <p class="muted">Fotky z našich akcí a zápasů.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% set albumsList = gallery.albums | default([]) %}

    {% if albumsList | length == 0 %}
      <p class="muted">Zatím tu nejsou žádné fotky. Přidejte alba v administraci v sekci „Data → Galerie".</p>
    {% else %}
      <div class="grid albums" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
        {% for album in albumsList %}
          <a href="{{ '/galerie/' ~ album.slug ~ '/' | url }}" style="display:block;color:inherit;text-decoration:none;">
            <article class="card" style="cursor: pointer;">
              <div class="card__media" style="--media-aspect: 16 / 9; --media-radius: 0;">
                {% if album.cover %}
                  {% image album.cover, album.title, "(max-width: 600px) 100vw, 360px", "gallery-cover" %}
                {% else %}
                  <div class="media-frame__placeholder media-frame__placeholder--compact">Bez fotky</div>
                {% endif %}
              </div>

              <div class="card__body">
                <h3 class="card__title">{{ album.title }}</h3>
                <p class="muted">{{ album.date | czDate }}</p>
                <p style="margin-top: 0.5rem; font-size: 0.9rem; color: var(--text-muted);">{{ album.photos | length }} fotek</p>

                {% if album.photos and album.photos | length > 0 %}
                  <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-top:12px;">
                    {% for photo in album.photos | slice(0, 4) %}
                      <div class="card__media" style="--media-aspect: 1 / 1; --media-radius: 8px; --media-fit: cover;">
                        {% set photoSrc = photo.photo if photo.photo else photo %}
                        {% image photoSrc, album.title ~ ' – fotka ' ~ loop.index, "(max-width: 400px) 25vw, 70px", "gallery-thumb" %}
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}

                <p style="margin-top:1rem;font-weight:600;color:var(--primary);">Otevřít galerii →</p>
              </div>
            </article>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
