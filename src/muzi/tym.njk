---
title: Tým Mužů
permalink: /muzi/tym/index.html
layout: layouts/page.njk
---

<nav class="muted" aria-label="Drobečková navigace" style="margin-bottom: 2rem;">
  <a href="{{ '/muzi/' | url }}">← Zpět na Muži</a>
</nav>

<section class="section">
  <div class="container">
    <h1>Tým Mužů</h1>
    <p class="muted">Soupiska a realizační tým.</p>
  </div>
</section>

{% if formationComputed.hasFormation %}
<section class="section formation-section">
  <div class="container">
    <h2 style="text-align:center; margin-bottom:.5rem;">Sestava</h2>
    <p class="muted" style="text-align:center; margin-bottom:1.5rem;">Rozestavení <strong>{{ formationComputed.name }}</strong></p>

    <div class="pitch">
      {# Pitch markings drawn via CSS #}
      <div class="pitch__lines">
        <div class="pitch__half"></div>
        <div class="pitch__circle"></div>
        <div class="pitch__box pitch__box--top"></div>
        <div class="pitch__box pitch__box--bot"></div>
        <div class="pitch__goal pitch__goal--top"></div>
        <div class="pitch__goal pitch__goal--bot"></div>
        <div class="pitch__arc pitch__arc--top"></div>
        <div class="pitch__arc pitch__arc--bot"></div>
        <div class="pitch__spot pitch__spot--top"></div>
        <div class="pitch__spot pitch__spot--bot"></div>
      </div>

      {# Player markers #}
      {% for p in formationComputed.players %}
        <div class="pitch__player" style="top:{{ p.top }}%;left:{{ p.left }}%;">
          <div class="pitch__avatar{% if p.slot == 'GK' %} pitch__avatar--gk{% endif %}">
            {% if p.number %}<span>{{ p.number }}</span>{% else %}<span>?</span>{% endif %}
          </div>
          <div class="pitch__name">{{ p.name if p.name else p.slot }}</div>
        </div>
      {% endfor %}
    </div>

    {# Bench / sideline roles #}
    {% if formationComputed.bench | length %}
    <div class="pitch-bench">
      {% for b in formationComputed.bench %}
        <div class="pitch-bench__item">
          <div class="pitch-bench__icon">{% if b.slot == 'TRENER' %}🎓{% else %}🧴{% endif %}</div>
          <div class="pitch-bench__info">
            <span class="pitch-bench__role">{{ b.roleLabel }}</span>
            <span class="pitch-bench__name">{{ b.name if b.name else '—' }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container">
    <h2>Hráči</h2>

    {% set menPlayers = players.men | default([]) | sort(false, false, 'number') %}

    {% if menPlayers | length == 0 %}
      <p class="muted">Zatím zde nejsou žádní hráči. Doplníš je v administraci v sekci „Data → Hráči – Muži".</p>
    {% else %}
      <div class="grid cards" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem;">
        {% for p in menPlayers %}
          <article class="card">
            <div class="card__media">
              {% if p.photo %}
                {% set __alt = "Fotka hráče " ~ p.name %}
                <img src="{{ p.photo }}" alt="{{ __alt }}" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px 4px 0 0;">
              {% else %}
                <div style="width: 100%; aspect-ratio: 1; background: #e0e0e0; border-radius: 4px 4px 0 0; display: flex; align-items: center; justify-content: center; color: #999;">
                  Bez fotky
                </div>
              {% endif %}
            </div>

            <div class="card__body">
              <h3 class="card__title">
                {% if p.number %}<span style="font-size: 0.8em; color: #999;">#{{ p.number }}</span> {% endif %}{{ p.name }}
              </h3>

              {% if p.position %}
                <p class="muted">{{ p.position }}</p>
              {% endif %}

              {% if p.stats %}
              <div class="player-stats">
                <div class="player-stats__item"><span class="player-stats__val">{{ p.stats.matches | default(0) }}</span><span class="player-stats__lbl">Zápasy</span></div>
                <div class="player-stats__item"><span class="player-stats__val">{{ p.stats.goals | default(0) }}</span><span class="player-stats__lbl">Góly</span></div>
                <div class="player-stats__item"><span class="player-stats__val">{{ p.stats.assists | default(0) }}</span><span class="player-stats__lbl">Asistence</span></div>
                <div class="player-stats__item player-stats__item--yellow"><span class="player-stats__val">{{ p.stats.yellow_cards | default(0) }}</span><span class="player-stats__lbl">ŽK</span></div>
                <div class="player-stats__item player-stats__item--red"><span class="player-stats__val">{{ p.stats.red_cards | default(0) }}</span><span class="player-stats__lbl">ČK</span></div>
              </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<section class="section" style="background: #f9f9f9;">
  <div class="container">
    <h2>Realizační tým</h2>

    {% set staffList = staff.items | default(staff.members) | default([]) %}

    {% if staffList | length == 0 %}
      <p class="muted">Zatím zde není žádný realizační tým. Doplníš ho v administraci v sekci „Data → Realizační tým".</p>
    {% else %}
      <div class="grid staff" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
        {% for s in staffList %}
          <article class="card">
            <div class="card__body">
              <h3 class="card__title">{{ s.name }}</h3>
              <p class="muted"><strong>{{ s.role }}</strong></p>

              {% if s.phone or s.email or s.contact %}
                <div style="margin-top: 1rem; font-size: 0.9rem;">
                  {% if s.contact %}
                    <p>📌 {{ s.contact }}</p>
                  {% endif %}
                  {% if s.phone %}
                    <p>📞 <a href="tel:{{ s.phone }}">{{ s.phone }}</a></p>
                  {% endif %}
                  {% if s.email %}
                    <p>📧 <a href="mailto:{{ s.email }}">{{ s.email }}</a></p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
