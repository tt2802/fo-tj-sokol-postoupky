---
title: Zápasy Mužů
permalink: /muzi/zapasy/index.html
layout: layouts/page.njk
---


<section class="section">
  <div class="container">
    <h1>Zápasy Mužů</h1>
    <p class="muted">Přehled všech zápasů týmu.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div data-matches-controls>
      <div style="display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;">
        <select data-filter="season" style="padding: 0.5rem; border: 1px solid var(--border); border-radius: 4px; background: var(--bg-card); color: var(--text);">
          <option value="">Všechny sezóny</option>
        </select>
        <select data-filter="competition" style="padding: 0.5rem; border: 1px solid var(--border); border-radius: 4px; background: var(--bg-card); color: var(--text);">
          <option value="">Všechny soutěže</option>
        </select>
      </div>
    </div>

    {% set menMatches = matchesComputed.upcoming | where('team', 'muzi') %}
    {% set menPlayed = matchesComputed.played | where('team', 'muzi') %}

    {% if menMatches | length > 0 %}
      <h2>Nadcházející zápasy</h2>
      <div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
        {% for m in menMatches %}
          <article class="card match-card" data-season="{{ m.season }}" data-competition="{{ m.competition }}" data-team="muzi">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}{% if m.time %} · {{ m.time }}{% endif %}</p>
              <h3>
                <strong>{{ m.home }}</strong>
                vs
                <strong>{{ m.away }}</strong>
              </h3>
              <p class="muted">{{ m.venue }} · {{ m.competition }}</p>
              {% if m.liveUrl %}
                {% set liveEmbedId = 'live-muzi-' ~ m.slug %}
                <p><button type="button" class="btn btn--secondary" data-inline-video-toggle="{{ liveEmbedId }}">Sledovat živě</button></p>
                <div id="{{ liveEmbedId }}" class="video-embed" data-video-url="{{ m.liveUrl | escape }}" hidden></div>
              {% endif %}
              <p style="margin-top: 0.5rem;"><a href="{{ ('/muzi/zapasy/' ~ m.slug ~ '/') | url }}">Detail zápasu</a></p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if menPlayed | length > 0 %}
      <h2>Odehrané zápasy</h2>
      <div style="display: grid; gap: 1rem;">
        {% for m in menPlayed %}
          <article class="card match-card" data-season="{{ m.season }}" data-competition="{{ m.competition }}" data-team="muzi">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}</p>
              <h3>
                <strong>{{ m.home }}</strong>
                {% if m.homeScore is number and m.awayScore is number %}
                  <span style="color: var(--text-muted);">{{ m.homeScore }} : {{ m.awayScore }}</span>
                {% endif %}
                <strong>{{ m.away }}</strong>
              </h3>
              <p class="muted">{{ m.competition }} · {{ m.season }}</p>
              {% if m.videoUrl %}
                {% set videoEmbedId = 'video-muzi-' ~ m.slug %}
                <p><button type="button" class="btn btn--secondary" data-inline-video-toggle="{{ videoEmbedId }}">Přehrát video</button></p>
                <div id="{{ videoEmbedId }}" class="video-embed" data-video-url="{{ m.videoUrl | escape }}" hidden></div>
              {% endif %}
              <p style="margin-top: 0.5rem;"><a href="{{ ('/muzi/zapasy/' ~ m.slug ~ '/') | url }}">Detail zápasu</a></p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if menMatches | length == 0 and menPlayed | length == 0 %}
      <p class="muted">Zatím zde nejsou žádné zápasy. Přidejte je v administraci.</p>
    {% endif %}
  </div>
</section>

<script defer src="{{ '/assets/js/matches-filter.js' | url }}"></script>
