---
title: Zápasy Mužů
permalink: /muzi/zapasy/index.html
layout: layouts/page.njk
---

<nav class="muted" aria-label="Drobečková navigace" style="margin-bottom: 2rem;">
  <a href="/muzi/">← Zpět na Muži</a>
</nav>

<section class="section">
  <div class="container">
    <h1>Zápasy Mužů</h1>
    <p class="muted">Přehled všech zápasů týmu.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div data-matches-controls>
      <div style="display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;">
        <select data-filter="season" style="padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
          <option value="">Všechny sezóny</option>
        </select>
        <select data-filter="competition" style="padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
          <option value="">Všechny soutěže</option>
        </select>
      </div>
    </div>

    {% set menMatches = matchesComputed.upcoming | selectattr('team', 'equalto', 'muzi') | list %}
    {% set menPlayed = matchesComputed.played | selectattr('team', 'equalto', 'muzi') | list %}

    {% if menMatches | length > 0 %}
      <h2>Nadcházející zápasy</h2>
      <div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
        {% for m in menMatches %}
          <div class="card match-card" data-season="{{ m.season }}" data-competition="{{ m.competition }}" data-team="muzi">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}{% if m.time %} · {{ m.time }}{% endif %}</p>
              <h3>
                <strong>{{ m.home }}</strong>
                vs
                <strong>{{ m.away }}</strong>
              </h3>
              <p class="muted">{{ m.venue }} · {{ m.competition }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if menPlayed | length > 0 %}
      <h2>Odehrané zápasy</h2>
      <div style="display: grid; gap: 1rem;">
        {% for m in menPlayed %}
          <a href="/muzi/zapasy/{{ m.slug }}/" class="card match-card" data-season="{{ m.season }}" data-competition="{{ m.competition }}" data-team="muzi" style="text-decoration: none; color: inherit; cursor: pointer;">
            <div class="card__body">
              <p class="muted">{{ m._dt | czDate }}</p>
              <h3>
                <strong>{{ m.home }}</strong>
                {% if m.homeScore is number and m.awayScore is number %}
                  <span style="color: #666;">{{ m.homeScore }} : {{ m.awayScore }}</span>
                {% endif %}
                <strong>{{ m.away }}</strong>
              </h3>
              <p class="muted">{{ m.competition }} · {{ m.season }}</p>
              {% if m.videoUrl %}
                <p style="margin-top: 0.5rem; font-size: 0.9rem;">🎥 Video dostupné</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if menMatches | length == 0 and menPlayed | length == 0 %}
      <p class="muted">Zatím zde nejsou žádné zápasy. Přidejte je v administraci.</p>
    {% endif %}
  </div>
</section>

<script src="{{ '/assets/js/matches-filter.js' | url }}"></script>
