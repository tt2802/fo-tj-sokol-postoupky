---
layout: layouts/page.njk
pagination:
  data: gallery.albums
  size: 1
  alias: album
permalink: "/galerie/{{ album.slug }}/index.html"
eleventyComputed:
  title: "{{ album.title }}"
  description: "{{ album.title }} · Fotogalerie TJ Sokol Postoupky"
  ogTitle: "{{ album.title }}"
---

{% set albumPhotos = album.photos | default([]) %}

<section class="section">
  <div class="container">
    <p class="muted"><a href="{{ '/galerie/' | url }}">← Zpět do galerie</a></p>
    <h1>{{ album.title }}</h1>
    <p class="muted">{{ album.date | czDate }}</p>
    {% if album.description %}
      <p style="max-width: 72ch; line-height: 1.6; margin-top: 0.75rem; color: var(--text);">{{ album.description }}</p>
    {% endif %}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="content-card">
      <div class="card__media" style="--media-aspect: 16 / 9; --media-radius: 0;">
        {% if album.cover %}
          {% image album.cover, album.title, "(max-width: 800px) 100vw, 800px", "gallery-cover" %}
        {% else %}
          <div class="media-frame__placeholder media-frame__placeholder--compact">Bez fotky</div>
        {% endif %}
      </div>

      <div class="card__body">
        {% if albumPhotos and albumPhotos | length > 0 %}
          <div class="gallery-viewer" data-gallery-viewer>
            <div class="gallery-viewer__main-row">
              <button type="button" class="gallery-viewer__nav gallery-viewer__nav--prev" data-gallery-nav="prev" aria-label="Předchozí fotka">‹</button>

              <figure class="gallery-viewer__stage">
                {% set firstPhoto = albumPhotos[0] %}
                {% if firstPhoto.photo %}
                  {% set firstSrc = firstPhoto.photo %}
                  {% set firstAlt = firstPhoto.caption if firstPhoto.caption else album.title ~ ' – fotka 1' %}
                  {% set firstCaption = firstPhoto.caption if firstPhoto.caption else '' %}
                {% else %}
                  {% set firstSrc = firstPhoto %}
                  {% set firstAlt = album.title ~ ' – fotka 1' %}
                  {% set firstCaption = '' %}
                {% endif %}

                <button type="button" class="gallery-viewer__expand" data-gallery-open aria-label="Zvětšit fotku">
                  <img
                    class="gallery-viewer__image"
                    data-gallery-main
                    src="{{ firstSrc | url }}"
                    alt="{{ firstAlt }}"
                    loading="eager"
                    decoding="async"
                  >
                  <span class="gallery-viewer__expand-badge">Zvětšit</span>
                </button>

                <figcaption class="gallery-viewer__caption">
                  <strong>{{ album.title }}</strong>
                  <span data-gallery-caption>{{ firstCaption if firstCaption else firstAlt }}</span>
                  <span class="gallery-viewer__counter" data-gallery-counter>1 / {{ albumPhotos | length }}</span>
                </figcaption>
              </figure>

              <button type="button" class="gallery-viewer__nav gallery-viewer__nav--next" data-gallery-nav="next" aria-label="Další fotka">›</button>
            </div>

            <div class="gallery-viewer__thumbs" role="list" aria-label="Náhledy fotek">
              {% for photo in albumPhotos %}
                {% if photo.photo %}
                  {% set photoSrc = photo.photo %}
                  {% set photoAlt = photo.caption if photo.caption else album.title ~ ' – fotka ' ~ loop.index %}
                  {% set photoCaption = photo.caption if photo.caption else '' %}
                {% else %}
                  {% set photoSrc = photo %}
                  {% set photoAlt = album.title ~ ' – fotka ' ~ loop.index %}
                  {% set photoCaption = '' %}
                {% endif %}

                <button
                  type="button"
                  class="gallery-viewer__thumb{% if loop.first %} is-active{% endif %}"
                  data-gallery-thumb
                  data-index="{{ loop.index0 }}"
                  data-src="{{ photoSrc | url }}"
                  data-alt="{{ photoAlt }}"
                  data-caption="{{ photoCaption }}"
                  aria-label="{{ photoAlt }}"
                >
                  <span class="sr-only">{{ photoAlt }}</span>
                  <span class="gallery-viewer__thumb-media">
                    {% image photoSrc, photoAlt, "(max-width: 480px) 25vw, 120px", "gallery-viewer__thumb-img" %}
                  </span>
                </button>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <p class="muted">V tomto albu zatím nejsou žádné fotky.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% if albumPhotos and albumPhotos | length > 0 %}
<div class="gallery-lightbox" data-gallery-lightbox aria-hidden="true">
  <div class="gallery-lightbox__backdrop" data-gallery-close></div>
  <div class="gallery-lightbox__panel" role="dialog" aria-modal="true" aria-label="Zvětšená fotka">
    <button type="button" class="gallery-lightbox__close" data-gallery-close aria-label="Zavřít">×</button>
    <button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--prev" data-gallery-lightbox-nav="prev" aria-label="Předchozí fotka">‹</button>
    <figure class="gallery-lightbox__figure">
      <img class="gallery-lightbox__image" data-gallery-lightbox-image src="" alt="">
      <figcaption class="gallery-lightbox__caption">
        <strong>{{ album.title }}</strong>
        <span data-gallery-lightbox-caption></span>
        <span class="gallery-lightbox__counter" data-gallery-lightbox-counter></span>
      </figcaption>
    </figure>
    <button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--next" data-gallery-lightbox-nav="next" aria-label="Další fotka">›</button>
  </div>
</div>
{% endif %}

{% if albumPhotos and albumPhotos | length > 0 %}
<script>
(function() {
  var viewer = document.querySelector('[data-gallery-viewer]');
  if (!viewer) return;

  var mainImage = viewer.querySelector('[data-gallery-main]');
  var openBtn = viewer.querySelector('[data-gallery-open]');
  var captionEl = viewer.querySelector('[data-gallery-caption]');
  var counterEl = viewer.querySelector('[data-gallery-counter]');
  var thumbButtons = Array.prototype.slice.call(viewer.querySelectorAll('[data-gallery-thumb]'));
  var prevBtn = viewer.querySelector('[data-gallery-nav="prev"]');
  var nextBtn = viewer.querySelector('[data-gallery-nav="next"]');
  var lightbox = document.querySelector('[data-gallery-lightbox]');
  var lightboxImage = lightbox ? lightbox.querySelector('[data-gallery-lightbox-image]') : null;
  var lightboxCaption = lightbox ? lightbox.querySelector('[data-gallery-lightbox-caption]') : null;
  var lightboxCounter = lightbox ? lightbox.querySelector('[data-gallery-lightbox-counter]') : null;
  var lightboxPrev = lightbox ? lightbox.querySelector('[data-gallery-lightbox-nav="prev"]') : null;
  var lightboxNext = lightbox ? lightbox.querySelector('[data-gallery-lightbox-nav="next"]') : null;
  var closeBtns = lightbox ? Array.prototype.slice.call(lightbox.querySelectorAll('[data-gallery-close]')) : [];
  var items = thumbButtons.map(function(btn) {
    return {
      src: btn.getAttribute('data-src') || '',
      alt: btn.getAttribute('data-alt') || '',
      caption: btn.getAttribute('data-caption') || ''
    };
  });
  var index = 0;
  var lightboxOpen = false;

  function setActive(nextIndex, focusThumb) {
    if (!items.length) return;
    index = (nextIndex + items.length) % items.length;
    var item = items[index];

    mainImage.src = item.src;
    mainImage.alt = item.alt;
    captionEl.textContent = item.caption || item.alt;
    counterEl.textContent = (index + 1) + ' / ' + items.length;

    if (lightboxOpen && lightboxImage) {
      lightboxImage.src = item.src;
      lightboxImage.alt = item.alt;
      if (lightboxCaption) lightboxCaption.textContent = item.caption || item.alt;
      if (lightboxCounter) lightboxCounter.textContent = (index + 1) + ' / ' + items.length;
    }

    thumbButtons.forEach(function(btn, i) {
      btn.classList.toggle('is-active', i === index);
      btn.setAttribute('aria-current', i === index ? 'true' : 'false');
    });

    var activeThumb = thumbButtons[index];
    if (activeThumb) {
      activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      if (focusThumb) activeThumb.focus({ preventScroll: true });
    }
  }

  function openLightbox() {
    if (!lightbox || !items.length) return;
    var item = items[index];
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('is-lightbox-open');
    document.body.classList.add('is-lightbox-open');
    lightboxOpen = true;
    if (lightboxImage) {
      lightboxImage.src = item.src;
      lightboxImage.alt = item.alt;
    }
    if (lightboxCaption) lightboxCaption.textContent = item.caption || item.alt;
    if (lightboxCounter) lightboxCounter.textContent = (index + 1) + ' / ' + items.length;
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('is-lightbox-open');
    document.body.classList.remove('is-lightbox-open');
    lightboxOpen = false;
  }

  thumbButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      setActive(parseInt(btn.getAttribute('data-index'), 10) || 0, false);
    });
  });

  if (openBtn) openBtn.addEventListener('click', openLightbox);
  if (lightboxPrev) lightboxPrev.addEventListener('click', function() { setActive(index - 1, false); });
  if (lightboxNext) lightboxNext.addEventListener('click', function() { setActive(index + 1, false); });
  closeBtns.forEach(function(btn) {
    btn.addEventListener('click', closeLightbox);
  });

  if (lightbox) {
    lightbox.addEventListener('click', function(e) {
      if (e.target && e.target.hasAttribute('data-gallery-close')) {
        closeLightbox();
      }
    });
  }

  if (prevBtn) prevBtn.addEventListener('click', function() { setActive(index - 1, false); });
  if (nextBtn) nextBtn.addEventListener('click', function() { setActive(index + 1, false); });

  document.addEventListener('keydown', function(e) {
    if (e.defaultPrevented) return;
    var tag = (document.activeElement && document.activeElement.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select') return;

    if (e.key === 'Escape' && lightboxOpen) {
      e.preventDefault();
      closeLightbox();
      return;
    }

    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      setActive(index - 1, false);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      setActive(index + 1, false);
    }
  });

  setActive(0, false);
})();
</script>
{% endif %}
